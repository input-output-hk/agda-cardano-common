-- events on link `l` only (direct-on-constructor; the NetworkLinkOffers pattern)
apiLinkAlpha : Link → Alpha
apiLinkAlpha l (_ , input  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , output l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , sndmsg l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , rcvmsg l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , tx     l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , sndack l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , rcvack l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , ack    l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , done   l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiCS  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiBF  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiTS  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiKA  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiLN  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , apiLF  l′ _ _) _ = l′ ≡ l
apiLinkAlpha l (_ , break  l′)     _ = l′ ≡ l

-- distinct links confine disjoint alphabets (one event has one link)
apiLinkAlpha-disj : ∀ {l l′} → ¬ l ≡ l′ → Disj (apiLinkAlpha l) (apiLinkAlpha l′)
apiLinkAlpha-disj l≢l′ (_ , input  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , output _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , sndmsg _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , rcvmsg _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , tx     _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , sndack _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , rcvack _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , ack    _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , done   _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiCS  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiBF  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiTS  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiKA  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiLN  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , apiLF  _ _ _) _ refl q = l≢l′ q
apiLinkAlpha-disj l≢l′ (_ , break  _)     _ refl q = l≢l′ q

-- the two consume-side links are distinct (linkBD = #2, linkCD = #3)
linkBD≢linkCD : ¬ linkBD ≡ linkCD
linkBD≢linkCD ()

