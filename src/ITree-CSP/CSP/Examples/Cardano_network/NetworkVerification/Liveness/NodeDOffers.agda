-- the ts-s spec confines to link l
tsServerSpec-onLink : (l : Link) (d : Dir)
                        → OffersOnly (apiLinkAlpha l) (tsServerSpec l d)
tsServerSpec-onLink l d =
  tableSpec-OffersOnly (apiLinkAlpha l) _ (ts-s-edge-link l d) tsInit


------------------------------------------------------------------------
-- The spec bundle (mirrors `miniProtocols l hi lo`) and its link confinement.
------------------------------------------------------------------------

-- the τ-free spec bundle for link `l` (= left operand of `pipeSpec l hi`)
specBundle : (l : Link) → NetTree
specBundle l =
  kaClientSpec l hi ⦀ (kaServerSpec l lo
    ⦀ (csClientSpec l hi ⦀ (csServerSpec l lo
    ⦀ (bfClientSpec l hi ⦀ (bfServerSpec l lo
    ⦀ (tsClientSpec l hi ⦀ tsServerSpec l lo))))))

-- the spec bundle offers only link-`l` events (8-fold OffersOnly-⦀, one alpha)
specBundle-onLink : (l : Link) → OffersOnly (apiLinkAlpha l) (specBundle l)
specBundle-onLink l =
  OffersOnly-⦀ (kaClientSpec-onLink l hi)
    (OffersOnly-⦀ (kaServerSpec-onLink l lo)
    (OffersOnly-⦀ (csClientSpec-onLink l hi)
    (OffersOnly-⦀ (csServerSpec-onLink l lo)
    (OffersOnly-⦀ (bfClientSpec-onLink l hi)
    (OffersOnly-⦀ (bfServerSpec-onLink l lo)
    (OffersOnly-⦀ (tsClientSpec-onLink l hi) (tsServerSpec-onLink l lo)))))))

------------------------------------------------------------------------
-- IMPL-side link confinement, FOR FREE via the generic backward transfer
-- `≈DR-OO` (now in `DRCongruenceRep`).
--
-- Rather than regenerate the eight per-peer source `OffersOnly`s with a
-- link-refined alphabet, we transport the SPEC-side confinement backward
-- across the M1 bundle bisim `b0`: a ≈DR-related process offers no MORE
-- (weakly) than its partner, so if the spec bundle confines to link `l`,
-- so does the impl bundle `miniProtocols l hi lo`.
------------------------------------------------------------------------

-- the impl bundle offers only link-`l` events (transferred from the spec)
implBundle-onLink : (l : Link) → OffersOnly (apiLinkAlpha l) (miniProtocols l hi lo)
implBundle-onLink l = ≈DR-OO (b0 l) (specBundle-onLink l)
