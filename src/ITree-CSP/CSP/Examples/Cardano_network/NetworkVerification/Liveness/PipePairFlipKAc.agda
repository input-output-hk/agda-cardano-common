-- backward τ simulation: the spec is τ-free (vacuous)
kacBwdT : (l : Link) → ∀ {p q q′} → KACRel l p q → q ─[ τ ]─► q′
        → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × KACRel l p′ q′)
kacBwdT l cClient st = ⊥-elim (specNoτKC l kcClient st)
kacBwdT l (cAwait c) st = ⊥-elim (specNoτKC l (kcAwait c) st)
kacBwdT l cTerm st = ⊥-elim (specNoτKC l kcTerm st)
kacBwdT l mClient st = ⊥-elim (specNoτKC l kcClient st)
kacBwdT l (mServer c) st = ⊥-elim (specNoτKC l (kcAwait c) st)
kacBwdT l mDone st = ⊥-elim (specNoτKC l kcTerm st)
kacBwdT l (iWmsg c) st = ⊥-elim (specNoτKC l (kcWmsg c) st)
kacBwdT l iWdone st = ⊥-elim (specNoτKC l kcWdone st)
kacBwdT l iDdone st = ⊥-elim (specNoτKC l kcDdone st)
kacBwdT l cDead (sSil ())
kacBwdT l cDead (sTau refl ())

-- the impl never diverges
kacNdivL : (l : Link) → ∀ {p q} → KACRel l p q → Diverges p → ⊥
kacNdivL l cClient dv = noτ-ibKC l (cSrvC l stClient) refl (dv .Diverges.step)
kacNdivL l (cAwait c) dv = noτ-ibKC l (cSrvC l (stServer c)) refl (dv .Diverges.step)
kacNdivL l cTerm dv = noτ-retKC l (dv .Diverges.step)
kacNdivL l mClient dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibKC l (cSrvC l stClient) refl (rest .Diverges.step)
... | _ | sTau () _ | _
kacNdivL l (mServer c) dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibKC l (cSrvC l (stServer c)) refl (rest .Diverges.step)
... | _ | sTau () _ | _
kacNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retKC l (rest .Diverges.step)
... | _ | sTau () _ | _
kacNdivL l (iWmsg c) dv = noτ-ibKC l (SrcOp.Output (sendKA l lo) (valMsg c) (SrcOp.Ret (inj₁ (stServer c)))) refl (dv .Diverges.step)
kacNdivL l iWdone dv = noτ-ibKC l (SrcOp.Output (sendKA l lo) valKAdone (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone)))) refl (dv .Diverges.step)
kacNdivL l iDdone dv = noτ-ibKC l (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone))) refl (dv .Diverges.step)
kacNdivL l cDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges
kacNdivR : (l : Link) → ∀ {p q} → KACRel l p q → Diverges q → ⊥
kacNdivR l cClient dv = specNoτKC l kcClient (dv .Diverges.step)
kacNdivR l (cAwait c) dv = specNoτKC l (kcAwait c) (dv .Diverges.step)
kacNdivR l cTerm dv = specNoτKC l kcTerm (dv .Diverges.step)
kacNdivR l mClient dv = specNoτKC l kcClient (dv .Diverges.step)
kacNdivR l (mServer c) dv = specNoτKC l (kcAwait c) (dv .Diverges.step)
kacNdivR l mDone dv = specNoτKC l kcTerm (dv .Diverges.step)
kacNdivR l (iWmsg c) dv = specNoτKC l (kcWmsg c) (dv .Diverges.step)
kacNdivR l iWdone dv = specNoτKC l kcWdone (dv .Diverges.step)
kacNdivR l iDdone dv = specNoτKC l kcDdone (dv .Diverges.step)
kacNdivR l cDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the KA-client relation
module KACDR (l : Link) = DRFromRel (KACRel l) (kacFwdE l) (kacFwdT l) (kacBwdE l) (kacBwdT l) (kacNdivL l) (kacNdivR l)

-- THE FIRST CLIENT BISIM: the renamed KA client iter ≈DR its τ-free spec table
kaClient≈DRlo : (l : Link) → KAclientA l lo ≈DR kaClientSpec l lo
kaClient≈DRlo l = KACDR.rel→dr l cClient
