-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- the visible-menu application of a forced node (nothing on non-react shapes)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | ret _     = nothing
... | sil _     = nothing



------------------------------------------------------------------------
-- CLIENT GATE-REFLECTION design (KA client, the Part-8 concrete instance).
--
-- Part 8 flagged the client value-branch as a bisim risk: the KA client's
-- `stServer c` menu has an INTERNAL gate `cookieReq ≟ cookieRsp`
-- (`KeepAlive.clientStep`) whose two outcomes — loop back (kcClient) vs the
-- errCookie branch (kcErr c c′) — must reach DISTINCT spec targets, unlike
-- `OffersOnly` which only needed both to confine.
--
-- FINDING (positively resolves the risk at goalBD/goalCD scope): in the
-- concrete `p` (FourNodeDiamond), `Cookie ≡ ⊤` and `decCookie` is the
-- constantly-`yes refl` decision.  So `c ≟ c′` reduces to `yes refl` for
-- ALL c c′ (`gateYes`), the errCookie branch is STATICALLY DEAD, and the
-- spec positions `kcErr`/`kcTermE` are UNREACHABLE.  The KA client bisim
-- therefore maps EVERY response to the loop; it needs NO err-branch states
-- and NO reflection of a live gate.  The two lemmas below are all the
-- client-response case needs (both discharged by `gateYes`).
--
-- (For a GENERIC live cookie the reflection would `with c ≟ c′ in eqc` and
-- `rewrite eqc` into the two branches — sound on the spec table; at THIS
-- instance that machinery is unnecessary because the gate is constant.)
------------------------------------------------------------------------

-- the KA client step function at the concrete (linkBD , lo) instance
cSrvC : (l : Link) → KAState → PTree KAEv (ExtI KAEv) (KAState ⊎ Rr)
cSrvC l = clientStep l lo

-- the KA client spec table at (linkBD , lo)
Tkc : (l : Link) → Table KAcPos
Tkc l = record { isFin = kaCfin ; nxt = kaCnxt l lo }

-- impl HOME / MID states for the KA client
kacI : (l : Link) → KAState → NetTree
kacI l q = RenKA.renameMap (SrcOp.iter (cSrvC l) q)
kacIB : (l : Link) → PTree KAEv (ExtI KAEv) (KAState ⊎ Rr) → NetTree
kacIB l t = RenKA.renameMap (SrcOp.iter-bind t (cSrvC l))

-- the cookie gate is CONSTANT at this instance (Cookie ≡ ⊤ ⇒ decEq⊤)
gateYes : (c c′ : Cookie) → (c ≟ c′) ≡ yes refl
gateYes c c′ = refl

-- GATE-REFLECTION (degenerate): every response cookie c′ makes the client
-- loop — impl → the loop re-entry sil; spec → kcClient.  No err target.
kcLoopImpl : (l : Link) → (c c′ : Cookie) (t : Time) (m : Mode) (len : Length)
           → visOf (kacI l (stServer c)) (Payload , output l lo N2N_KeepAlive)
                   (t , m , len , keepAlive (MsgKeepAliveResponse c′))
               ≡ just (kacIB l (SrcOp.Ret (inj₁ stClient)))
kcLoopImpl F.zero c c′ t m len = refl
kcLoopImpl (F.suc F.zero) c c′ t m len = refl
kcLoopImpl (F.suc (F.suc F.zero)) c c′ t m len = refl
kcLoopImpl (F.suc (F.suc (F.suc F.zero))) c c′ t m len = refl

kcLoopSpec : (l : Link) → (c c′ : Cookie) (t : Time) (m : Mode) (len : Length)
           → tMenu (Tkc l) (kcAwait c) (Payload , output l lo N2N_KeepAlive)
                   (t , m , len , keepAlive (MsgKeepAliveResponse c′))
               ≡ just (tableSpec (Tkc l) kcClient)
kcLoopSpec F.zero c c′ t m len = refl
kcLoopSpec (F.suc F.zero) c c′ t m len = refl
kcLoopSpec (F.suc (F.suc F.zero)) c c′ t m len = refl
kcLoopSpec (F.suc (F.suc (F.suc F.zero))) c c′ t m len = refl

------------------------------------------------------------------------
-- Item 3, THIRD PEER BISIM (FIRST CLIENT): `KAclientA linkBD lo ≈DR
-- kaClientSpec linkBD lo`.  Validates the CLIENT template.  Cookie ≡ ⊤
-- makes the response gate degenerate (gateYes) ⇒ the errCookie branch is
-- dead ⇒ NO kcErr/kcTermE states; the client is the keepalive loop
-- (cClient → iWmsg → cAwait → loop) with a sendKADone exit to √.
-- Reuses cSrvC/Tkc/kacI/kacIB + the gate-reflection lemmas already proved.
------------------------------------------------------------------------

-- the two fixed wire-send payloads the client emits (FromInitiator)
valMsg : Cookie → Payload
valMsg c = (time₀ , FromInitiator , length₀ , keepAlive (MsgKeepAlive c))
valKAdone : Payload
valKAdone = (time₀ , FromInitiator , length₀ , keepAlive MsgKADone)

-- the KA-client bisimulation relation: reachable impl states ↔ spec positions
data KACRel (l : Link) : NetTree → NetTree → Set₁ where
  cClient : KACRel l (kacI l stClient) (tableSpec (Tkc l) kcClient)
  cAwait : (c : Cookie) → KACRel l (kacI l (stServer c)) (tableSpec (Tkc l) (kcAwait c))
  cTerm : KACRel l (kacI l stDone) (tableSpec (Tkc l) kcTerm)
  mClient : KACRel l (kacIB l (SrcOp.Ret (inj₁ stClient))) (tableSpec (Tkc l) kcClient)
  mServer : (c : Cookie) → KACRel l (kacIB l (SrcOp.Ret (inj₁ (stServer c)))) (tableSpec (Tkc l) (kcAwait c))
  mDone : KACRel l (kacIB l (SrcOp.Ret (inj₁ stDone))) (tableSpec (Tkc l) kcTerm)
  iWmsg : (c : Cookie) → KACRel l (kacIB l (SrcOp.Output (sendKA l lo) (valMsg c) (SrcOp.Ret (inj₁ (stServer c))))) (tableSpec (Tkc l) (kcWmsg c))
  iWdone : KACRel l (kacIB l (SrcOp.Output (sendKA l lo) valKAdone (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone))))) (tableSpec (Tkc l) kcWdone)
  iDdone : KACRel l (kacIB l (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone)))) (tableSpec (Tkc l) kcDdone)
  cDead : KACRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ-part) has no τ
noτ-ibKC : (l : Link) (Q : PTree KAEv (ExtI KAEv) (KAState ⊎ Rr))
           {vq : (at : AnyTypes KAEv) → ContinueType at (Maybe (PTree KAEv (ExtI KAEv) (KAState ⊎ Rr)))}
         → PTree.force Q ≡ react vq SrcOp.∅t
         → ∀ {X} → kacIB l Q ─[ τ ]─► X → ⊥
noτ-ibKC l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibKC l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibKC l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenKA.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retKC : (l : Link) → ∀ {X} → kacI l stDone ─[ τ ]─► X → ⊥
noτ-retKC l (sSil ())
noτ-retKC l (sTau () _)

-- the τ-free client spec table has no τ at any position
specNoτKC : (l : Link) (q : KAcPos) {X : NetTree} → tableSpec (Tkc l) q ─[ τ ]─► X → ⊥
specNoτKC l kcClient (sSil ())
specNoτKC l kcClient (sTau refl ())
specNoτKC l (kcWmsg c) (sSil ())
specNoτKC l (kcWmsg c) (sTau refl ())
specNoτKC l (kcAwait c) (sSil ())
specNoτKC l (kcAwait c) (sTau refl ())
specNoτKC l kcWdone (sSil ())
specNoτKC l kcWdone (sTau refl ())
specNoτKC l kcDdone (sSil ())
specNoτKC l kcDdone (sTau refl ())
specNoτKC l (kcErr cq cr) (sSil ())
specNoτKC l (kcErr cq cr) (sTau refl ())
specNoτKC l kcTerm (sSil ())
specNoτKC l kcTerm (sTau () _)
specNoτKC l kcTermE (sSil ())
specNoτKC l kcTermE (sTau () _)

-- value-gated wire-send firings (impl `Output` gate + spec `pl ≟` gate)
kcWmsgImpl : (l : Link) → (c : Cookie) → visOf (kacIB l (SrcOp.Output (sendKA l lo) (valMsg c) (SrcOp.Ret (inj₁ (stServer c))))) (Payload , input l lo N2N_KeepAlive) (valMsg c) ≡ just (kacIB l (SrcOp.Ret (inj₁ (stServer c))))
kcWmsgImpl F.zero c rewrite ≟-diagP (valMsg c) = refl
kcWmsgImpl (F.suc F.zero) c rewrite ≟-diagP (valMsg c) = refl
kcWmsgImpl (F.suc (F.suc F.zero)) c rewrite ≟-diagP (valMsg c) = refl
kcWmsgImpl (F.suc (F.suc (F.suc F.zero))) c rewrite ≟-diagP (valMsg c) = refl
kcWmsgSpec : (l : Link) → (c : Cookie) → tMenu (Tkc l) (kcWmsg c) (Payload , input l lo N2N_KeepAlive) (valMsg c) ≡ just (tableSpec (Tkc l) (kcAwait c))
kcWmsgSpec F.zero c rewrite ≟-diagP (valMsg c) = refl
kcWmsgSpec (F.suc F.zero) c rewrite ≟-diagP (valMsg c) = refl
kcWmsgSpec (F.suc (F.suc F.zero)) c rewrite ≟-diagP (valMsg c) = refl
kcWmsgSpec (F.suc (F.suc (F.suc F.zero))) c rewrite ≟-diagP (valMsg c) = refl
kcWdnImpl : (l : Link) → visOf (kacIB l (SrcOp.Output (sendKA l lo) valKAdone (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone))))) (Payload , input l lo N2N_KeepAlive) valKAdone ≡ just (kacIB l (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone))))
kcWdnImpl F.zero rewrite ≟-diagP valKAdone = refl
kcWdnImpl (F.suc F.zero) rewrite ≟-diagP valKAdone = refl
kcWdnImpl (F.suc (F.suc F.zero)) rewrite ≟-diagP valKAdone = refl
kcWdnImpl (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valKAdone = refl
kcWdnSpec : (l : Link) → tMenu (Tkc l) kcWdone (Payload , input l lo N2N_KeepAlive) valKAdone ≡ just (tableSpec (Tkc l) kcDdone)
kcWdnSpec F.zero rewrite ≟-diagP valKAdone = refl
kcWdnSpec (F.suc F.zero) rewrite ≟-diagP valKAdone = refl
kcWdnSpec (F.suc (F.suc F.zero)) rewrite ≟-diagP valKAdone = refl
kcWdnSpec (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valKAdone = refl

