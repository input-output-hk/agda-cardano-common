-- forward τ simulation: the only impl τs are the loop re-entry sils
tsFwdT : (l : Link) → ∀ {p q p′} → TSSRel l p q → p ─[ τ ]─► p′
       → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × TSSRel l p′ q′)
tsFwdT l sInit st = ⊥-elim (noτ-ibTS l (sSrv l TS.stInit) refl st)
tsFwdT l sIdle st = ⊥-elim (noτ-ibTS l (sSrv l TS.stIdle) refl st)
tsFwdT l sBlk st = ⊥-elim (noτ-ibTS l (sSrv l TS.stTxIdsBlocking) refl st)
tsFwdT l sNbl st = ⊥-elim (noτ-ibTS l (sSrv l TS.stTxIdsNonBlocking) refl st)
tsFwdT l sTxs st = ⊥-elim (noτ-ibTS l (sSrv l TS.stTxs) refl st)
tsFwdT l sDone st = ⊥-elim (noτ-retTS l st)
tsFwdT l mIdle (sSil refl) = _ , wτ τ*-refl , sIdle
tsFwdT l mIdle (sTau () _)
tsFwdT l mBlk (sSil refl) = _ , wτ τ*-refl , sBlk
tsFwdT l mBlk (sTau () _)
tsFwdT l mNbl (sSil refl) = _ , wτ τ*-refl , sNbl
tsFwdT l mNbl (sTau () _)
tsFwdT l mTxs (sSil refl) = _ , wτ τ*-refl , sTxs
tsFwdT l mTxs (sTau () _)
tsFwdT l mDone (sSil refl) = _ , wτ τ*-refl , sDone
tsFwdT l mDone (sTau () _)
tsFwdT l (iWib ar) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWib ar) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) refl st)
tsFwdT l (iWin ar) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWin ar) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) refl st)
tsFwdT l (iWrt ids) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWrt ids) (SrcOpT.Ret (inj₁ TS.stTxs))) refl st)
tsFwdT l iDdone st = ⊥-elim (noτ-ibTS l (SrcOpT.Prefix₀ (TS.doneTS l hi) (SrcOpT.Ret (inj₁ TS.stDone))) refl st)
tsFwdT l sDead (sSil ())
tsFwdT l sDead (sTau refl ())

