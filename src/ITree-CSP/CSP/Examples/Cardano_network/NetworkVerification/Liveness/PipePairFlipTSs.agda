-- backward τ simulation: the spec is τ-free (vacuous)
tsBwdT : (l : Link) → ∀ {p q q′} → TSSRel l p q → q ─[ τ ]─► q′
       → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × TSSRel l p′ q′)
tsBwdT l sInit st = ⊥-elim (specNoτTS l tsInit st)
tsBwdT l sIdle st = ⊥-elim (specNoτTS l tsIdle st)
tsBwdT l sBlk st = ⊥-elim (specNoτTS l tsBlk st)
tsBwdT l sNbl st = ⊥-elim (specNoτTS l tsNbl st)
tsBwdT l sTxs st = ⊥-elim (specNoτTS l tsTxs st)
tsBwdT l sDone st = ⊥-elim (specNoτTS l tsTerm st)
tsBwdT l mIdle st = ⊥-elim (specNoτTS l tsIdle st)
tsBwdT l mBlk st = ⊥-elim (specNoτTS l tsBlk st)
tsBwdT l mNbl st = ⊥-elim (specNoτTS l tsNbl st)
tsBwdT l mTxs st = ⊥-elim (specNoτTS l tsTxs st)
tsBwdT l mDone st = ⊥-elim (specNoτTS l tsTerm st)
tsBwdT l (iWib ar) st = ⊥-elim (specNoτTS l (tsWib ar) st)
tsBwdT l (iWin ar) st = ⊥-elim (specNoτTS l (tsWin ar) st)
tsBwdT l (iWrt ids) st = ⊥-elim (specNoτTS l (tsWrt ids) st)
tsBwdT l iDdone st = ⊥-elim (specNoτTS l tsDdone st)
tsBwdT l sDead (sSil ())
tsBwdT l sDead (sTau refl ())

-- the impl never diverges: stable states have no τ; sils τ once into a stable one
tsNdivL : (l : Link) → ∀ {p q} → TSSRel l p q → Diverges p → ⊥
tsNdivL l sInit dv = noτ-ibTS l (sSrv l TS.stInit) refl (dv .Diverges.step)
tsNdivL l sIdle dv = noτ-ibTS l (sSrv l TS.stIdle) refl (dv .Diverges.step)
tsNdivL l sBlk dv = noτ-ibTS l (sSrv l TS.stTxIdsBlocking) refl (dv .Diverges.step)
tsNdivL l sNbl dv = noτ-ibTS l (sSrv l TS.stTxIdsNonBlocking) refl (dv .Diverges.step)
tsNdivL l sTxs dv = noτ-ibTS l (sSrv l TS.stTxs) refl (dv .Diverges.step)
tsNdivL l sDone dv = noτ-retTS l (dv .Diverges.step)
tsNdivL l mIdle dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (sSrv l TS.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tsNdivL l mBlk dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (sSrv l TS.stTxIdsBlocking) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tsNdivL l mNbl dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (sSrv l TS.stTxIdsNonBlocking) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tsNdivL l mTxs dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (sSrv l TS.stTxs) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tsNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retTS l (rest .Diverges.step)
... | _ | sTau () _ | _
tsNdivL l (iWib ar) dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWib ar) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) refl (dv .Diverges.step)
tsNdivL l (iWin ar) dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWin ar) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) refl (dv .Diverges.step)
tsNdivL l (iWrt ids) dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l hi) (valWrt ids) (SrcOpT.Ret (inj₁ TS.stTxs))) refl (dv .Diverges.step)
tsNdivL l iDdone dv = noτ-ibTS l (SrcOpT.Prefix₀ (TS.doneTS l hi) (SrcOpT.Ret (inj₁ TS.stDone))) refl (dv .Diverges.step)
tsNdivL l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
tsNdivR : (l : Link) → ∀ {p q} → TSSRel l p q → Diverges q → ⊥
tsNdivR l sInit dv = specNoτTS l tsInit (dv .Diverges.step)
tsNdivR l sIdle dv = specNoτTS l tsIdle (dv .Diverges.step)
tsNdivR l sBlk dv = specNoτTS l tsBlk (dv .Diverges.step)
tsNdivR l sNbl dv = specNoτTS l tsNbl (dv .Diverges.step)
tsNdivR l sTxs dv = specNoτTS l tsTxs (dv .Diverges.step)
tsNdivR l sDone dv = specNoτTS l tsTerm (dv .Diverges.step)
tsNdivR l mIdle dv = specNoτTS l tsIdle (dv .Diverges.step)
tsNdivR l mBlk dv = specNoτTS l tsBlk (dv .Diverges.step)
tsNdivR l mNbl dv = specNoτTS l tsNbl (dv .Diverges.step)
tsNdivR l mTxs dv = specNoτTS l tsTxs (dv .Diverges.step)
tsNdivR l mDone dv = specNoτTS l tsTerm (dv .Diverges.step)
tsNdivR l (iWib ar) dv = specNoτTS l (tsWib ar) (dv .Diverges.step)
tsNdivR l (iWin ar) dv = specNoτTS l (tsWin ar) (dv .Diverges.step)
tsNdivR l (iWrt ids) dv = specNoτTS l (tsWrt ids) (dv .Diverges.step)
tsNdivR l iDdone dv = specNoτTS l tsDdone (dv .Diverges.step)
tsNdivR l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the TS-server relation
module TSSDR (l : Link) = DRFromRel (TSSRel l) (tsFwdE l) (tsFwdT l) (tsBwdE l) (tsBwdT l) (tsNdivL l) (tsNdivR l)

-- THE TS-SERVER PEER BISIM: the renamed TS requester iter ≈DR its τ-free spec table
tsServer≈DRhi : (l : Link) → TSserverA l hi ≈DR tsServerSpec l hi
tsServer≈DRhi l = TSSDR.rel→dr l sInit
