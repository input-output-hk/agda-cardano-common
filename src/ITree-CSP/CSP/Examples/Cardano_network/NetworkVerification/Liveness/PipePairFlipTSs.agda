specNoτTS l tsInit (sSil ())
specNoτTS l tsInit (sTau refl ())
specNoτTS l tsIdle (sSil ())
specNoτTS l tsIdle (sTau refl ())
specNoτTS l (tsWib ar) (sSil ())
specNoτTS l (tsWib ar) (sTau refl ())
specNoτTS l (tsWin ar) (sSil ())
specNoτTS l (tsWin ar) (sTau refl ())
specNoτTS l (tsWrt ids) (sSil ())
specNoτTS l (tsWrt ids) (sTau refl ())
specNoτTS l tsBlk (sSil ())
specNoτTS l tsBlk (sTau refl ())
specNoτTS l tsNbl (sSil ())
specNoτTS l tsNbl (sTau refl ())
specNoτTS l tsTxs (sSil ())
specNoτTS l tsTxs (sTau refl ())
specNoτTS l tsDdone (sSil ())
