-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- the one-step successor of a react node under a visible offer (its menu)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | _         = nothing

-- the TS server (requester) step at the concrete server direction (hi, flipped)
sSrv : (l : Link) → TS.TSState → PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr)
sSrv l = TS.serverStep l hi

-- the TS server spec table
Tts : (l : Link) → Table TSsPos
Tts l = record { isFin = tsSfin ; nxt = tsSnxt l hi }

-- impl HOME state: the renamed iter at a requester FSM position
tsI : (l : Link) → TS.TSState → NetTree
tsI l q = RenTS.renameMap (SrcOpT.iter (sSrv l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
tsIB : (l : Link) → PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr) → NetTree
tsIB l t = RenTS.renameMap (SrcOpT.iter-bind t (sSrv l))

-- the fixed wire-send payloads the requester emits (FromResponder)
valWib : ℕ × ℕ → Payload
valWib (a , r) = (time₀ , FromResponder , length₀ , txSubmission (MsgTSRequestTxIds Blocking a r))
valWin : ℕ × ℕ → Payload
valWin (a , r) = (time₀ , FromResponder , length₀ , txSubmission (MsgTSRequestTxIds NonBlocking a r))
valWrt : List Txid → Payload
valWrt ids = (time₀ , FromResponder , length₀ , txSubmission (MsgTSRequestTxs ids))

-- the TS-server bisimulation relation: reachable impl states ↔ spec positions
data TSSRel (l : Link) : NetTree → NetTree → Set₁ where
  sInit : TSSRel l (tsI l TS.stInit) (tableSpec (Tts l) tsInit)
  sIdle : TSSRel l (tsI l TS.stIdle) (tableSpec (Tts l) tsIdle)
  sBlk : TSSRel l (tsI l TS.stTxIdsBlocking) (tableSpec (Tts l) tsBlk)
  sNbl : TSSRel l (tsI l TS.stTxIdsNonBlocking) (tableSpec (Tts l) tsNbl)
  sTxs : TSSRel l (tsI l TS.stTxs) (tableSpec (Tts l) tsTxs)
  sDone : TSSRel l (tsI l TS.stDone) (tableSpec (Tts l) tsTerm)
  mIdle : TSSRel l (tsIB l (SrcOpT.Ret (inj₁ TS.stIdle))) (tableSpec (Tts l) tsIdle)
  mBlk : TSSRel l (tsIB l (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) (tableSpec (Tts l) tsBlk)
  mNbl : TSSRel l (tsIB l (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) (tableSpec (Tts l) tsNbl)
  mTxs : TSSRel l (tsIB l (SrcOpT.Ret (inj₁ TS.stTxs))) (tableSpec (Tts l) tsTxs)
  mDone : TSSRel l (tsIB l (SrcOpT.Ret (inj₁ TS.stDone))) (tableSpec (Tts l) tsTerm)
  iWib : (ar : ℕ × ℕ) → TSSRel l (tsIB l (SrcOpT.Output (TS.sendTS l hi) (valWib ar) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking)))) (tableSpec (Tts l) (tsWib ar))
  iWin : (ar : ℕ × ℕ) → TSSRel l (tsIB l (SrcOpT.Output (TS.sendTS l hi) (valWin ar) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking)))) (tableSpec (Tts l) (tsWin ar))
  iWrt : (ids : List Txid) → TSSRel l (tsIB l (SrcOpT.Output (TS.sendTS l hi) (valWrt ids) (SrcOpT.Ret (inj₁ TS.stTxs)))) (tableSpec (Tts l) (tsWrt ids))
  iDdone : TSSRel l (tsIB l (SrcOpT.Prefix₀ (TS.doneTS l hi) (SrcOpT.Ret (inj₁ TS.stDone)))) (tableSpec (Tts l) tsDdone)
  sDead : TSSRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ) has no τ
noτ-ibTS : (l : Link) (Q : PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr))
           {vq : (at : AnyTypes TS.TSEv) → ContinueType at (Maybe (PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr)))}
         → PTree.force Q ≡ react vq SrcOpT.∅t
         → ∀ {X} → tsIB l Q ─[ τ ]─► X → ⊥
noτ-ibTS l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibTS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibTS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenTS.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retTS : (l : Link) → ∀ {X} → tsI l TS.stDone ─[ τ ]─► X → ⊥
noτ-retTS l (sSil ())
noτ-retTS l (sTau () _)

-- the τ-free spec table has no τ at any position
