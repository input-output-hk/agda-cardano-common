-- backward τ simulation: the spec is τ-free (vacuous)
tcBwdT : (l : Link) → ∀ {p q q′} → TSCRel l p q → q ─[ τ ]─► q′
       → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × TSCRel l p′ q′)
tcBwdT l cInit st = ⊥-elim (specNoτTS l tcInit st)
tcBwdT l cIdle st = ⊥-elim (specNoτTS l tcIdle st)
tcBwdT l cBlk st = ⊥-elim (specNoτTS l tcBlk st)
tcBwdT l cNbl st = ⊥-elim (specNoτTS l tcNbl st)
tcBwdT l cTxs st = ⊥-elim (specNoτTS l tcTxs st)
tcBwdT l cDone st = ⊥-elim (specNoτTS l tcTerm st)
tcBwdT l mIdle st = ⊥-elim (specNoτTS l tcIdle st)
tcBwdT l mBlk st = ⊥-elim (specNoτTS l tcBlk st)
tcBwdT l mNbl st = ⊥-elim (specNoτTS l tcNbl st)
tcBwdT l mTxs st = ⊥-elim (specNoτTS l tcTxs st)
tcBwdT l mDone st = ⊥-elim (specNoτTS l tcTerm st)
tcBwdT l (iAriB a r) st = ⊥-elim (specNoτTS l (tcAri (Blocking , a , r)) st)
tcBwdT l (iAriN a r) st = ⊥-elim (specNoτTS l (tcAri (NonBlocking , a , r)) st)
tcBwdT l (iArt ids) st = ⊥-elim (specNoτTS l (tcArt ids) st)
tcBwdT l (iWri ids) st = ⊥-elim (specNoτTS l (tcWri ids) st)
tcBwdT l iWdone st = ⊥-elim (specNoτTS l tcWdone st)
tcBwdT l iDdone st = ⊥-elim (specNoτTS l tcDdone st)
tcBwdT l (iWrt txs) st = ⊥-elim (specNoτTS l (tcWrt txs) st)
tcBwdT l sDead (sSil ())
tcBwdT l sDead (sTau refl ())

-- the impl never diverges: stable states have no τ; sils τ once into a stable one
tcNdivL : (l : Link) → ∀ {p q} → TSCRel l p q → Diverges p → ⊥
tcNdivL l cInit dv = noτ-ibTS l (cCli l TS.stInit) refl (dv .Diverges.step)
tcNdivL l cIdle dv = noτ-ibTS l (cCli l TS.stIdle) refl (dv .Diverges.step)
tcNdivL l cBlk dv = noτ-ibTS l (cCli l TS.stTxIdsBlocking) refl (dv .Diverges.step)
tcNdivL l cNbl dv = noτ-ibTS l (cCli l TS.stTxIdsNonBlocking) refl (dv .Diverges.step)
tcNdivL l cTxs dv = noτ-ibTS l (cCli l TS.stTxs) refl (dv .Diverges.step)
tcNdivL l cDone dv = noτ-retTS l (dv .Diverges.step)
tcNdivL l mIdle dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (cCli l TS.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tcNdivL l mBlk dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (cCli l TS.stTxIdsBlocking) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tcNdivL l mNbl dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (cCli l TS.stTxIdsNonBlocking) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tcNdivL l mTxs dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibTS l (cCli l TS.stTxs) refl (rest .Diverges.step)
... | _ | sTau () _ | _
tcNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retTS l (rest .Diverges.step)
... | _ | sTau () _ | _
tcNdivL l (iAriB a r) dv = noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (Blocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) refl (dv .Diverges.step)
tcNdivL l (iAriN a r) dv = noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (NonBlocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) refl (dv .Diverges.step)
tcNdivL l (iArt ids) dv = noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-List ⦄ (TS.apiTSev l lo recvTSRequestTxs) ids (SrcOpT.Ret (inj₁ TS.stTxs))) refl (dv .Diverges.step)
tcNdivL l (iWri ids) dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) (valRepIds ids) (SrcOpT.Ret (inj₁ TS.stIdle))) refl (dv .Diverges.step)
tcNdivL l iWdone dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) valDone (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone)))) refl (dv .Diverges.step)
tcNdivL l iDdone dv = noτ-ibTS l (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone))) refl (dv .Diverges.step)
tcNdivL l (iWrt txs) dv = noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) (valRepTxs txs) (SrcOpT.Ret (inj₁ TS.stIdle))) refl (dv .Diverges.step)
tcNdivL l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
tcNdivR : (l : Link) → ∀ {p q} → TSCRel l p q → Diverges q → ⊥
tcNdivR l cInit dv = specNoτTS l tcInit (dv .Diverges.step)
tcNdivR l cIdle dv = specNoτTS l tcIdle (dv .Diverges.step)
tcNdivR l cBlk dv = specNoτTS l tcBlk (dv .Diverges.step)
tcNdivR l cNbl dv = specNoτTS l tcNbl (dv .Diverges.step)
tcNdivR l cTxs dv = specNoτTS l tcTxs (dv .Diverges.step)
tcNdivR l cDone dv = specNoτTS l tcTerm (dv .Diverges.step)
tcNdivR l mIdle dv = specNoτTS l tcIdle (dv .Diverges.step)
tcNdivR l mBlk dv = specNoτTS l tcBlk (dv .Diverges.step)
tcNdivR l mNbl dv = specNoτTS l tcNbl (dv .Diverges.step)
tcNdivR l mTxs dv = specNoτTS l tcTxs (dv .Diverges.step)
tcNdivR l mDone dv = specNoτTS l tcTerm (dv .Diverges.step)
tcNdivR l (iAriB a r) dv = specNoτTS l (tcAri (Blocking , a , r)) (dv .Diverges.step)
tcNdivR l (iAriN a r) dv = specNoτTS l (tcAri (NonBlocking , a , r)) (dv .Diverges.step)
tcNdivR l (iArt ids) dv = specNoτTS l (tcArt ids) (dv .Diverges.step)
tcNdivR l (iWri ids) dv = specNoτTS l (tcWri ids) (dv .Diverges.step)
tcNdivR l iWdone dv = specNoτTS l tcWdone (dv .Diverges.step)
tcNdivR l iDdone dv = specNoτTS l tcDdone (dv .Diverges.step)
tcNdivR l (iWrt txs) dv = specNoτTS l (tcWrt txs) (dv .Diverges.step)
tcNdivR l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the TS-client relation
module TSCDR (l : Link) = DRFromRel (TSCRel l) (tcFwdE l) (tcFwdT l) (tcBwdE l) (tcBwdT l) (tcNdivL l) (tcNdivR l)

-- THE TS-CLIENT PEER BISIM: the renamed TS submitter iter ≈DR its τ-free spec table
tsClient≈DRlo : (l : Link) → TSclientA l lo ≈DR tsClientSpec l lo
tsClient≈DRlo l = TSCDR.rel→dr l cInit
