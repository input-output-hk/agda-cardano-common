-- forward τ simulation: the only impl τs are the loop re-entry sils
tcFwdT : (l : Link) → ∀ {p q p′} → TSCRel l p q → p ─[ τ ]─► p′
       → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × TSCRel l p′ q′)
tcFwdT l cInit st = ⊥-elim (noτ-ibTS l (cCli l TS.stInit) refl st)
tcFwdT l cIdle st = ⊥-elim (noτ-ibTS l (cCli l TS.stIdle) refl st)
tcFwdT l cBlk st = ⊥-elim (noτ-ibTS l (cCli l TS.stTxIdsBlocking) refl st)
tcFwdT l cNbl st = ⊥-elim (noτ-ibTS l (cCli l TS.stTxIdsNonBlocking) refl st)
tcFwdT l cTxs st = ⊥-elim (noτ-ibTS l (cCli l TS.stTxs) refl st)
tcFwdT l cDone st = ⊥-elim (noτ-retTS l st)
tcFwdT l mIdle (sSil refl) = _ , wτ τ*-refl , cIdle
tcFwdT l mIdle (sTau () _)
tcFwdT l mBlk (sSil refl) = _ , wτ τ*-refl , cBlk
tcFwdT l mBlk (sTau () _)
tcFwdT l mNbl (sSil refl) = _ , wτ τ*-refl , cNbl
tcFwdT l mNbl (sTau () _)
tcFwdT l mTxs (sSil refl) = _ , wτ τ*-refl , cTxs
tcFwdT l mTxs (sTau () _)
tcFwdT l mDone (sSil refl) = _ , wτ τ*-refl , cDone
tcFwdT l mDone (sTau () _)
tcFwdT l (iAriB a r) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (Blocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) refl st)
tcFwdT l (iAriN a r) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (NonBlocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) refl st)
tcFwdT l (iArt ids) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output ⦃ DecEqI.DecEq-List ⦄ (TS.apiTSev l lo recvTSRequestTxs) ids (SrcOpT.Ret (inj₁ TS.stTxs))) refl st)
tcFwdT l (iWri ids) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) (valRepIds ids) (SrcOpT.Ret (inj₁ TS.stIdle))) refl st)
tcFwdT l iWdone st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) valDone (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone)))) refl st)
tcFwdT l iDdone st = ⊥-elim (noτ-ibTS l (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone))) refl st)
tcFwdT l (iWrt txs) st = ⊥-elim (noτ-ibTS l (SrcOpT.Output (TS.sendTS l lo) (valRepTxs txs) (SrcOpT.Ret (inj₁ TS.stIdle))) refl st)
tcFwdT l sDead (sSil ())
tcFwdT l sDead (sTau refl ())

