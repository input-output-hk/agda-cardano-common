-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- x ≟ x for BlockingStyle × ℕ × ℕ (instance pinned to DecEqI.DecEq-×)
≟-diagBSₙ : (x : BlockingStyle × ℕ × ℕ) → (_≟_ ⦃ DecEqI.DecEq-× ⦄ x x) ≡ yes refl
≟-diagBSₙ x = ≡-≟-identity (_≟_ ⦃ DecEqI.DecEq-× ⦄) refl

-- x ≟ x for List Txid (instance pinned to DecEqI.DecEq-List)
≟-diagLTx : (x : List Txid) → (_≟_ ⦃ DecEqI.DecEq-List ⦄ x x) ≡ yes refl
≟-diagLTx x = ≡-≟-identity (_≟_ ⦃ DecEqI.DecEq-List ⦄) refl

-- the one-step successor of a react node under a visible offer (its menu)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | _         = nothing

-- the TS client (submitter) step at the concrete client direction (lo, flipped)
cCli : (l : Link) → TS.TSState → PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr)
cCli l = TS.clientStep l lo

-- the TS client spec table
Ttc : (l : Link) → Table TScPos
Ttc l = record { isFin = tsCfin ; nxt = tsCnxt l lo }

-- impl HOME state: the renamed iter at a submitter FSM position
tcI : (l : Link) → TS.TSState → NetTree
tcI l q = RenTS.renameMap (SrcOpT.iter (cCli l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
tcIB : (l : Link) → PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr) → NetTree
tcIB l t = RenTS.renameMap (SrcOpT.iter-bind t (cCli l))

-- the fixed wire-send payloads the submitter emits (FromInitiator)
valInit : Payload
valInit = (time₀ , FromInitiator , length₀ , txSubmission MsgTSInit)
valRepIds : List Txid → Payload
valRepIds ids = (time₀ , FromInitiator , length₀ , txSubmission (MsgTSReplyTxIds ids))
valDone : Payload
valDone = (time₀ , FromInitiator , length₀ , txSubmission MsgTSDone)
valRepTxs : List Tx → Payload
valRepTxs txs = (time₀ , FromInitiator , length₀ , txSubmission (MsgTSReplyTxs txs))

-- the TS-client bisimulation relation: reachable impl states ↔ spec positions
data TSCRel (l : Link) : NetTree → NetTree → Set₁ where
  cInit : TSCRel l (tcI l TS.stInit) (tableSpec (Ttc l) tcInit)
  cIdle : TSCRel l (tcI l TS.stIdle) (tableSpec (Ttc l) tcIdle)
  cBlk : TSCRel l (tcI l TS.stTxIdsBlocking) (tableSpec (Ttc l) tcBlk)
  cNbl : TSCRel l (tcI l TS.stTxIdsNonBlocking) (tableSpec (Ttc l) tcNbl)
  cTxs : TSCRel l (tcI l TS.stTxs) (tableSpec (Ttc l) tcTxs)
  cDone : TSCRel l (tcI l TS.stDone) (tableSpec (Ttc l) tcTerm)
  mIdle : TSCRel l (tcIB l (SrcOpT.Ret (inj₁ TS.stIdle))) (tableSpec (Ttc l) tcIdle)
  mBlk : TSCRel l (tcIB l (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking))) (tableSpec (Ttc l) tcBlk)
  mNbl : TSCRel l (tcIB l (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking))) (tableSpec (Ttc l) tcNbl)
  mTxs : TSCRel l (tcIB l (SrcOpT.Ret (inj₁ TS.stTxs))) (tableSpec (Ttc l) tcTxs)
  mDone : TSCRel l (tcIB l (SrcOpT.Ret (inj₁ TS.stDone))) (tableSpec (Ttc l) tcTerm)
  iAriB : (a r : ℕ) → TSCRel l (tcIB l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (Blocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsBlocking)))) (tableSpec (Ttc l) (tcAri (Blocking , a , r)))
  iAriN : (a r : ℕ) → TSCRel l (tcIB l (SrcOpT.Output ⦃ DecEqI.DecEq-× ⦄ (TS.apiTSev l lo recvTSRequestTxIds) (NonBlocking , a , r) (SrcOpT.Ret (inj₁ TS.stTxIdsNonBlocking)))) (tableSpec (Ttc l) (tcAri (NonBlocking , a , r)))
  iArt : (ids : List Txid) → TSCRel l (tcIB l (SrcOpT.Output ⦃ DecEqI.DecEq-List ⦄ (TS.apiTSev l lo recvTSRequestTxs) ids (SrcOpT.Ret (inj₁ TS.stTxs)))) (tableSpec (Ttc l) (tcArt ids))
  iWri : (ids : List Txid) → TSCRel l (tcIB l (SrcOpT.Output (TS.sendTS l lo) (valRepIds ids) (SrcOpT.Ret (inj₁ TS.stIdle)))) (tableSpec (Ttc l) (tcWri ids))
  iWdone : TSCRel l (tcIB l (SrcOpT.Output (TS.sendTS l lo) valDone (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone))))) (tableSpec (Ttc l) tcWdone)
  iDdone : TSCRel l (tcIB l (SrcOpT.Prefix₀ (TS.doneTS l lo) (SrcOpT.Ret (inj₁ TS.stDone)))) (tableSpec (Ttc l) tcDdone)
  iWrt : (txs : List Tx) → TSCRel l (tcIB l (SrcOpT.Output (TS.sendTS l lo) (valRepTxs txs) (SrcOpT.Ret (inj₁ TS.stIdle)))) (tableSpec (Ttc l) (tcWrt txs))
  sDead : TSCRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ) has no τ
noτ-ibTS : (l : Link) (Q : PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr))
           {vq : (at : AnyTypes TS.TSEv) → ContinueType at (Maybe (PTree TS.TSEv (ExtI TS.TSEv) (TS.TSState ⊎ TS.Rr)))}
         → PTree.force Q ≡ react vq SrcOpT.∅t
         → ∀ {X} → tcIB l Q ─[ τ ]─► X → ⊥
noτ-ibTS l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibTS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibTS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenTS.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retTS : (l : Link) → ∀ {X} → tcI l TS.stDone ─[ τ ]─► X → ⊥
noτ-retTS l (sSil ())
noτ-retTS l (sTau () _)

-- the τ-free spec table has no τ at any position
specNoτTS : (l : Link) (q : TScPos) {X : NetTree} → tableSpec (Ttc l) q ─[ τ ]─► X → ⊥
specNoτTS l tcInit (sSil ())
specNoτTS l tcInit (sTau refl ())
specNoτTS l tcIdle (sSil ())
specNoτTS l tcIdle (sTau refl ())
specNoτTS l (tcAri bar) (sSil ())
specNoτTS l (tcAri bar) (sTau refl ())
specNoτTS l tcBlk (sSil ())
specNoτTS l tcBlk (sTau refl ())
specNoτTS l tcNbl (sSil ())
specNoτTS l tcNbl (sTau refl ())
specNoτTS l (tcArt ids) (sSil ())
specNoτTS l (tcArt ids) (sTau refl ())
specNoτTS l tcTxs (sSil ())
specNoτTS l tcTxs (sTau refl ())
specNoτTS l (tcWri ids) (sSil ())
specNoτTS l (tcWri ids) (sTau refl ())
specNoτTS l tcWdone (sSil ())
specNoτTS l tcWdone (sTau refl ())
specNoτTS l tcDdone (sSil ())
specNoτTS l tcDdone (sTau refl ())
specNoτTS l (tcWrt txs) (sSil ())
specNoτTS l (tcWrt txs) (sTau refl ())
specNoτTS l tcTerm (sSil ())
specNoτTS l tcTerm (sTau () _)

