-- backward τ simulation (spec τ-free)
bfcBwdT : (l : Link) → ∀ {p q q′} → BFCRel l p q → q ─[ τ ]─► q′
        → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × BFCRel l p′ q′)
bfcBwdT l qI st = ⊥-elim (specNoτBC l bcIdle st)
bfcBwdT l qB st = ⊥-elim (specNoτBC l bcBusy st)
bfcBwdT l qS st = ⊥-elim (specNoτBC l bcStream st)
bfcBwdT l qT st = ⊥-elim (specNoτBC l bcTerm st)
bfcBwdT l rI st = ⊥-elim (specNoτBC l bcIdle st)
bfcBwdT l rB st = ⊥-elim (specNoτBC l bcBusy st)
bfcBwdT l rS st = ⊥-elim (specNoτBC l bcStream st)
bfcBwdT l rD st = ⊥-elim (specNoτBC l bcTerm st)
bfcBwdT l (wRr r) st = ⊥-elim (specNoτBC l (bcWrr r) st)
bfcBwdT l wCd st = ⊥-elim (specNoτBC l bcWcd st)
bfcBwdT l dD st = ⊥-elim (specNoτBC l bcDdone st)
bfcBwdT l (aB b) st = ⊥-elim (specNoτBC l (bcAblk b) st)
bfcBwdT l xD (sSil ())
bfcBwdT l xD (sTau refl ())

-- the impl never diverges
bfcNdivL : (l : Link) → ∀ {p q} → BFCRel l p q → Diverges p → ⊥
bfcNdivL l qI dv = noτ-ibBC l (cSrvBC l BF.stIdle) refl (dv .Diverges.step)
bfcNdivL l qB dv = noτ-ibBC l (cSrvBC l BF.stBusy) refl (dv .Diverges.step)
bfcNdivL l qS dv = noτ-ibBC l (cSrvBC l BF.stStreaming) refl (dv .Diverges.step)
bfcNdivL l qT dv = noτ-retBC l (dv .Diverges.step)
bfcNdivL l rI dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBC l (cSrvBC l BF.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfcNdivL l rB dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBC l (cSrvBC l BF.stBusy) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfcNdivL l rS dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBC l (cSrvBC l BF.stStreaming) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfcNdivL l rD dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retBC l (rest .Diverges.step)
... | _ | sTau () _ | _
bfcNdivL l (wRr r) dv = noτ-ibBC l (SrcOpB.Output (BF.sendBF l hi) (valRR r) (SrcOpB.Ret (inj₁ BF.stBusy))) refl (dv .Diverges.step)
bfcNdivL l wCd dv = noτ-ibBC l (SrcOpB.Output (BF.sendBF l hi) valCD (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone)))) refl (dv .Diverges.step)
bfcNdivL l dD dv = noτ-ibBC l (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone))) refl (dv .Diverges.step)
bfcNdivL l (aB b) dv = noτ-ibBC l (SrcOpB.Output (BF.apiBFev l hi recvBFBlock) b (SrcOpB.Ret (inj₁ BF.stStreaming))) refl (dv .Diverges.step)
bfcNdivL l xD dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges
bfcNdivR : (l : Link) → ∀ {p q} → BFCRel l p q → Diverges q → ⊥
bfcNdivR l qI dv = specNoτBC l bcIdle (dv .Diverges.step)
bfcNdivR l qB dv = specNoτBC l bcBusy (dv .Diverges.step)
bfcNdivR l qS dv = specNoτBC l bcStream (dv .Diverges.step)
bfcNdivR l qT dv = specNoτBC l bcTerm (dv .Diverges.step)
bfcNdivR l rI dv = specNoτBC l bcIdle (dv .Diverges.step)
bfcNdivR l rB dv = specNoτBC l bcBusy (dv .Diverges.step)
bfcNdivR l rS dv = specNoτBC l bcStream (dv .Diverges.step)
bfcNdivR l rD dv = specNoτBC l bcTerm (dv .Diverges.step)
bfcNdivR l (wRr r) dv = specNoτBC l (bcWrr r) (dv .Diverges.step)
bfcNdivR l wCd dv = specNoτBC l bcWcd (dv .Diverges.step)
bfcNdivR l dD dv = specNoτBC l bcDdone (dv .Diverges.step)
bfcNdivR l (aB b) dv = specNoτBC l (bcAblk b) (dv .Diverges.step)
bfcNdivR l xD dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the BF-client relation
module BFCDR (l : Link) = DRFromRel (BFCRel l) (bfcFwdE l) (bfcFwdT l) (bfcBwdE l) (bfcBwdT l) (bfcNdivL l) (bfcNdivR l)

-- THE BF-CLIENT BISIM: the renamed BF client iter ≈DR its τ-free spec table
bfClient≈DR : (l : Link) → BFclientA l hi ≈DR bfClientSpec l hi
bfClient≈DR l = BFCDR.rel→dr l qI
