-- forward τ simulation
bfcFwdT : (l : Link) → ∀ {p q p′} → BFCRel l p q → p ─[ τ ]─► p′
        → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × BFCRel l p′ q′)
bfcFwdT l qI st = ⊥-elim (noτ-ibBC l (cSrvBC l BF.stIdle) refl st)
bfcFwdT l qB st = ⊥-elim (noτ-ibBC l (cSrvBC l BF.stBusy) refl st)
bfcFwdT l qS st = ⊥-elim (noτ-ibBC l (cSrvBC l BF.stStreaming) refl st)
bfcFwdT l qT st = ⊥-elim (noτ-retBC l st)
bfcFwdT l rI (sSil refl) = _ , wτ τ*-refl , qI
bfcFwdT l rI (sTau () _)
bfcFwdT l rB (sSil refl) = _ , wτ τ*-refl , qB
bfcFwdT l rB (sTau () _)
bfcFwdT l rS (sSil refl) = _ , wτ τ*-refl , qS
bfcFwdT l rS (sTau () _)
bfcFwdT l rD (sSil refl) = _ , wτ τ*-refl , qT
bfcFwdT l rD (sTau () _)
bfcFwdT l (wRr r) st = ⊥-elim (noτ-ibBC l (SrcOpB.Output (BF.sendBF l hi) (valRR r) (SrcOpB.Ret (inj₁ BF.stBusy))) refl st)
bfcFwdT l wCd st = ⊥-elim (noτ-ibBC l (SrcOpB.Output (BF.sendBF l hi) valCD (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone)))) refl st)
bfcFwdT l dD st = ⊥-elim (noτ-ibBC l (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone))) refl st)
bfcFwdT l (aB b) st = ⊥-elim (noτ-ibBC l (SrcOpB.Output (BF.apiBFev l hi recvBFBlock) b (SrcOpB.Ret (inj₁ BF.stStreaming))) refl st)
bfcFwdT l xD (sSil ())
bfcFwdT l xD (sTau refl ())

