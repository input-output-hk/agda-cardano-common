-- Item 3, FOURTH PEER BISIM (BF client): `BFclientA linkBD hi ≈DR
-- bfClientSpec linkBD hi`.  Validates the client template on a
-- NON-degenerate multi-state protocol (streaming loop, api-gate emit).
------------------------------------------------------------------------

-- the BF client step function at (linkBD , hi)
cSrvBC : (l : Link) → BF.BFState → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)
cSrvBC l = BF.clientStep l hi

-- the BF client spec table at (linkBD , hi)
Tbc : (l : Link) → Table BFcPos
Tbc l = record { isFin = bfCfin ; nxt = bfCnxt l hi }

-- impl HOME / MID states for the BF client
bcI : (l : Link) → BF.BFState → NetTree
bcI l q = RenBF.renameMap (SrcOpB.iter (cSrvBC l) q)
bcIB : (l : Link) → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr) → NetTree
bcIB l t = RenBF.renameMap (SrcOpB.iter-bind t (cSrvBC l))

-- b ≟ b computes to yes refl for the Block DecEq (repo ≟-diag idiom)
≟-diagBlk : (b : Block) → (b ≟ b) ≡ yes refl
≟-diagBlk b = ≡-≟-identity _≟_ refl

-- the two fixed wire-send payloads the client emits (FromInitiator)
valRR : ChainRange → Payload
valRR r = (time₀ , FromInitiator , length₀ , blockFetch (MsgRequestRange r))
valCD : Payload
valCD = (time₀ , FromInitiator , length₀ , blockFetch MsgClientDone)

-- the BF-client bisimulation relation
data BFCRel (l : Link) : NetTree → NetTree → Set₁ where
  qI : BFCRel l (bcI l BF.stIdle) (tableSpec (Tbc l) bcIdle)
  qB : BFCRel l (bcI l BF.stBusy) (tableSpec (Tbc l) bcBusy)
  qS : BFCRel l (bcI l BF.stStreaming) (tableSpec (Tbc l) bcStream)
  qT : BFCRel l (bcI l BF.stDone) (tableSpec (Tbc l) bcTerm)
  rI : BFCRel l (bcIB l (SrcOpB.Ret (inj₁ BF.stIdle))) (tableSpec (Tbc l) bcIdle)
  rB : BFCRel l (bcIB l (SrcOpB.Ret (inj₁ BF.stBusy))) (tableSpec (Tbc l) bcBusy)
  rS : BFCRel l (bcIB l (SrcOpB.Ret (inj₁ BF.stStreaming))) (tableSpec (Tbc l) bcStream)
  rD : BFCRel l (bcIB l (SrcOpB.Ret (inj₁ BF.stDone))) (tableSpec (Tbc l) bcTerm)
  wRr : (r : ChainRange) → BFCRel l (bcIB l (SrcOpB.Output (BF.sendBF l hi) (valRR r) (SrcOpB.Ret (inj₁ BF.stBusy)))) (tableSpec (Tbc l) (bcWrr r))
  wCd : BFCRel l (bcIB l (SrcOpB.Output (BF.sendBF l hi) valCD (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone))))) (tableSpec (Tbc l) bcWcd)
  dD : BFCRel l (bcIB l (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone)))) (tableSpec (Tbc l) bcDdone)
  aB : (b : Block) → BFCRel l (bcIB l (SrcOpB.Output (BF.apiBFev l hi recvBFBlock) b (SrcOpB.Ret (inj₁ BF.stStreaming)))) (tableSpec (Tbc l) (bcAblk b))
  xD : BFCRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node has no τ
noτ-ibBC : (l : Link) (Q : PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr))
           {vq : (at : AnyTypes BF.BFEv) → ContinueType at (Maybe (PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)))}
         → PTree.force Q ≡ react vq SrcOpB.∅t
         → ∀ {X} → bcIB l Q ─[ τ ]─► X → ⊥
noτ-ibBC l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibBC l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibBC l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenBF.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

noτ-retBC : (l : Link) → ∀ {X} → bcI l BF.stDone ─[ τ ]─► X → ⊥
noτ-retBC l (sSil ())
noτ-retBC l (sTau () _)

specNoτBC : (l : Link) (q : BFcPos) {X : NetTree} → tableSpec (Tbc l) q ─[ τ ]─► X → ⊥
specNoτBC l bcIdle (sSil ())
specNoτBC l bcIdle (sTau refl ())
specNoτBC l (bcWrr r) (sSil ())
specNoτBC l (bcWrr r) (sTau refl ())
specNoτBC l bcBusy (sSil ())
specNoτBC l bcBusy (sTau refl ())
specNoτBC l bcWcd (sSil ())
specNoτBC l bcWcd (sTau refl ())
specNoτBC l bcDdone (sSil ())
specNoτBC l bcDdone (sTau refl ())
specNoτBC l bcStream (sSil ())
specNoτBC l bcStream (sTau refl ())
specNoτBC l (bcAblk b) (sSil ())
specNoτBC l (bcAblk b) (sTau refl ())
specNoτBC l bcTerm (sSil ())
specNoτBC l bcTerm (sTau () _)

