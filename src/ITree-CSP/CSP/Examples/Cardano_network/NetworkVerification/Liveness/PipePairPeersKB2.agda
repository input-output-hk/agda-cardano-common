bfcAblkImpl (F.suc (F.suc F.zero)) b rewrite ≟-diagBlk b = refl
bfcAblkImpl (F.suc (F.suc (F.suc F.zero))) b rewrite ≟-diagBlk b = refl
bfcAblkSpec : (l : Link) → (b : Block) → tMenu (Tbc l) (bcAblk b) (Block , apiBF l hi recvBFBlock) b ≡ just (tableSpec (Tbc l) bcStream)
