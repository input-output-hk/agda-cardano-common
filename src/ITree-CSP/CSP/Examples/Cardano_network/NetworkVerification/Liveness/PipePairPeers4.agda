-- backward τ simulation: the spec is τ-free (vacuous)
ccBwdT : (l : Link) → ∀ {p q q′} → CSCRel l p q → q ─[ τ ]─► q′
       → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × CSCRel l p′ q′)
ccBwdT l cIdle st = ⊥-elim (specNoτCS l ccIdle st)
ccBwdT l cAwait st = ⊥-elim (specNoτCS l ccAwait st)
ccBwdT l cMust st = ⊥-elim (specNoτCS l ccMust st)
ccBwdT l cInt st = ⊥-elim (specNoτCS l ccInt st)
ccBwdT l cDone st = ⊥-elim (specNoτCS l ccTerm st)
ccBwdT l mIdle st = ⊥-elim (specNoτCS l ccIdle st)
ccBwdT l mAwait st = ⊥-elim (specNoτCS l ccAwait st)
ccBwdT l mMust st = ⊥-elim (specNoτCS l ccMust st)
ccBwdT l mInt st = ⊥-elim (specNoτCS l ccInt st)
ccBwdT l mDone st = ⊥-elim (specNoτCS l ccTerm st)
ccBwdT l iWreq st = ⊥-elim (specNoτCS l ccWreq st)
ccBwdT l (iWfi pts) st = ⊥-elim (specNoτCS l (ccWfi pts) st)
ccBwdT l iWdone st = ⊥-elim (specNoτCS l ccWdone st)
ccBwdT l iDdone st = ⊥-elim (specNoτCS l ccDdone st)
ccBwdT l (iArf ht) st = ⊥-elim (specNoτCS l (ccArf ht) st)
ccBwdT l (iArb pt) st = ⊥-elim (specNoτCS l (ccArb pt) st)
ccBwdT l (iAif pt) st = ⊥-elim (specNoτCS l (ccAif pt) st)
ccBwdT l (iAin tp) st = ⊥-elim (specNoτCS l (ccAin tp) st)
ccBwdT l cDead (sSil ())
ccBwdT l cDead (sTau refl ())

-- the impl never diverges: stable states have no τ; sils τ once into a stable one
ccNdivL : (l : Link) → ∀ {p q} → CSCRel l p q → Diverges p → ⊥
ccNdivL l cIdle dv = noτ-ibCS l (cCli l CS.stIdle) refl (dv .Diverges.step)
ccNdivL l cAwait dv = noτ-ibCS l (cCli l CS.stCanAwait) refl (dv .Diverges.step)
ccNdivL l cMust dv = noτ-ibCS l (cCli l CS.stMustReply) refl (dv .Diverges.step)
ccNdivL l cInt dv = noτ-ibCS l (cCli l CS.stIntersect) refl (dv .Diverges.step)
ccNdivL l cDone dv = noτ-retCS l (dv .Diverges.step)
ccNdivL l mIdle dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cCli l CS.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
ccNdivL l mAwait dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cCli l CS.stCanAwait) refl (rest .Diverges.step)
... | _ | sTau () _ | _
ccNdivL l mMust dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cCli l CS.stMustReply) refl (rest .Diverges.step)
... | _ | sTau () _ | _
ccNdivL l mInt dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cCli l CS.stIntersect) refl (rest .Diverges.step)
... | _ | sTau () _ | _
ccNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retCS l (rest .Diverges.step)
... | _ | sTau () _ | _
ccNdivL l iWreq dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) valReq (SrcOpC.Ret (inj₁ CS.stCanAwait))) refl (dv .Diverges.step)
ccNdivL l (iWfi pts) dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) (valFi pts) (SrcOpC.Ret (inj₁ CS.stIntersect))) refl (dv .Diverges.step)
ccNdivL l iWdone dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) valDone (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone)))) refl (dv .Diverges.step)
ccNdivL l iDdone dv = noτ-ibCS l (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone))) refl (dv .Diverges.step)
ccNdivL l (iArf ht) dv = noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollforward) ht (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
ccNdivL l (iArb pt) dv = noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollback) pt (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
ccNdivL l (iAif pt) dv = noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSIntersectFound) pt (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
ccNdivL l (iAin tp) dv = noτ-ibCS l (SrcOpC.Output (CS.apiCSev l hi recvCSIntersectNotFound) tp (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
ccNdivL l cDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
ccNdivR : (l : Link) → ∀ {p q} → CSCRel l p q → Diverges q → ⊥
ccNdivR l cIdle dv = specNoτCS l ccIdle (dv .Diverges.step)
ccNdivR l cAwait dv = specNoτCS l ccAwait (dv .Diverges.step)
ccNdivR l cMust dv = specNoτCS l ccMust (dv .Diverges.step)
ccNdivR l cInt dv = specNoτCS l ccInt (dv .Diverges.step)
ccNdivR l cDone dv = specNoτCS l ccTerm (dv .Diverges.step)
ccNdivR l mIdle dv = specNoτCS l ccIdle (dv .Diverges.step)
ccNdivR l mAwait dv = specNoτCS l ccAwait (dv .Diverges.step)
ccNdivR l mMust dv = specNoτCS l ccMust (dv .Diverges.step)
ccNdivR l mInt dv = specNoτCS l ccInt (dv .Diverges.step)
ccNdivR l mDone dv = specNoτCS l ccTerm (dv .Diverges.step)
ccNdivR l iWreq dv = specNoτCS l ccWreq (dv .Diverges.step)
ccNdivR l (iWfi pts) dv = specNoτCS l (ccWfi pts) (dv .Diverges.step)
ccNdivR l iWdone dv = specNoτCS l ccWdone (dv .Diverges.step)
ccNdivR l iDdone dv = specNoτCS l ccDdone (dv .Diverges.step)
ccNdivR l (iArf ht) dv = specNoτCS l (ccArf ht) (dv .Diverges.step)
ccNdivR l (iArb pt) dv = specNoτCS l (ccArb pt) (dv .Diverges.step)
ccNdivR l (iAif pt) dv = specNoτCS l (ccAif pt) (dv .Diverges.step)
ccNdivR l (iAin tp) dv = specNoτCS l (ccAin tp) (dv .Diverges.step)
ccNdivR l cDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the CS-client relation
module CSCDR (l : Link) = DRFromRel (CSCRel l) (ccFwdE l) (ccFwdT l) (ccBwdE l) (ccBwdT l) (ccNdivL l) (ccNdivR l)

-- THE CS-CLIENT PEER BISIM: the renamed CS client iter ≈DR its τ-free spec table
csClient≈DR : (l : Link) → CSclientA l hi ≈DR csClientSpec l hi
csClient≈DR l = CSCDR.rel→dr l cIdle
