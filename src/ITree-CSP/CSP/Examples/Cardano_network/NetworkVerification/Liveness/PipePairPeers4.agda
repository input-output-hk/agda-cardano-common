-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- ≟-diag for the product/Tip api-emit carriers (product instances pinned)
≟-diagHT : (x : Header × Tip) → (_≟_ ⦃ DecEqI.DecEq-× ⦄ x x) ≡ yes refl
≟-diagHT x = ≡-≟-identity (_≟_ ⦃ DecEqI.DecEq-× ⦄) refl
≟-diagPT : (x : Point × Tip) → (_≟_ ⦃ DecEqI.DecEq-× ⦄ x x) ≡ yes refl
≟-diagPT x = ≡-≟-identity (_≟_ ⦃ DecEqI.DecEq-× ⦄) refl
≟-diagT : (x : Tip) → (x ≟ x) ≡ yes refl
≟-diagT x = ≡-≟-identity _≟_ refl

-- the one-step successor of a react node under a visible offer (its menu)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | _         = nothing

-- the CS client step function at the concrete client direction (hi)
cCli : (l : Link) → CS.CSState → PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr)
cCli l = CS.clientStep l hi

-- the CS client spec table
Tcc : (l : Link) → Table CScPos
Tcc l = record { isFin = csCfin ; nxt = csCnxt l hi }

-- impl HOME state: the renamed iter at a client FSM position
cscI : (l : Link) → CS.CSState → NetTree
cscI l q = RenCS.renameMap (SrcOpC.iter (cCli l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
cscIB : (l : Link) → PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr) → NetTree
cscIB l t = RenCS.renameMap (SrcOpC.iter-bind t (cCli l))

-- the fixed wire-send payloads the client emits (FromInitiator)
valReq : Payload
valReq = (time₀ , FromInitiator , length₀ , chainSync MsgCSRequestNext)
valFi : List Point → Payload
valFi pts = (time₀ , FromInitiator , length₀ , chainSync (MsgCSFindIntersect pts))
valDone : Payload
valDone = (time₀ , FromInitiator , length₀ , chainSync MsgCSDone)

-- the CS-client bisimulation relation: reachable impl states ↔ spec positions
data CSCRel (l : Link) : NetTree → NetTree → Set₁ where
  cIdle : CSCRel l (cscI l CS.stIdle) (tableSpec (Tcc l) ccIdle)
  cAwait : CSCRel l (cscI l CS.stCanAwait) (tableSpec (Tcc l) ccAwait)
  cMust : CSCRel l (cscI l CS.stMustReply) (tableSpec (Tcc l) ccMust)
  cInt : CSCRel l (cscI l CS.stIntersect) (tableSpec (Tcc l) ccInt)
  cDone : CSCRel l (cscI l CS.stDone) (tableSpec (Tcc l) ccTerm)
  mIdle : CSCRel l (cscIB l (SrcOpC.Ret (inj₁ CS.stIdle))) (tableSpec (Tcc l) ccIdle)
  mAwait : CSCRel l (cscIB l (SrcOpC.Ret (inj₁ CS.stCanAwait))) (tableSpec (Tcc l) ccAwait)
  mMust : CSCRel l (cscIB l (SrcOpC.Ret (inj₁ CS.stMustReply))) (tableSpec (Tcc l) ccMust)
  mInt : CSCRel l (cscIB l (SrcOpC.Ret (inj₁ CS.stIntersect))) (tableSpec (Tcc l) ccInt)
  mDone : CSCRel l (cscIB l (SrcOpC.Ret (inj₁ CS.stDone))) (tableSpec (Tcc l) ccTerm)
  iWreq : CSCRel l (cscIB l (SrcOpC.Output (CS.sendCS l hi) valReq (SrcOpC.Ret (inj₁ CS.stCanAwait)))) (tableSpec (Tcc l) ccWreq)
  iWfi : (pts : List Point) → CSCRel l (cscIB l (SrcOpC.Output (CS.sendCS l hi) (valFi pts) (SrcOpC.Ret (inj₁ CS.stIntersect)))) (tableSpec (Tcc l) (ccWfi pts))
  iWdone : CSCRel l (cscIB l (SrcOpC.Output (CS.sendCS l hi) valDone (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone))))) (tableSpec (Tcc l) ccWdone)
  iDdone : CSCRel l (cscIB l (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone)))) (tableSpec (Tcc l) ccDdone)
  iArf : (ht : Header × Tip) → CSCRel l (cscIB l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollforward) ht (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcc l) (ccArf ht))
  iArb : (pt : Point × Tip) → CSCRel l (cscIB l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollback) pt (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcc l) (ccArb pt))
  iAif : (pt : Point × Tip) → CSCRel l (cscIB l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSIntersectFound) pt (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcc l) (ccAif pt))
  iAin : (tp : Tip) → CSCRel l (cscIB l (SrcOpC.Output (CS.apiCSev l hi recvCSIntersectNotFound) tp (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcc l) (ccAin tp))
  cDead : CSCRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ) has no τ
noτ-ibCS : (l : Link) (Q : PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr))
           {vq : (at : AnyTypes CS.CSEv) → ContinueType at (Maybe (PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr)))}
         → PTree.force Q ≡ react vq SrcOpC.∅t
         → ∀ {X} → cscIB l Q ─[ τ ]─► X → ⊥
noτ-ibCS l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibCS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibCS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenCS.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retCS : (l : Link) → ∀ {X} → cscI l CS.stDone ─[ τ ]─► X → ⊥
noτ-retCS l (sSil ())
noτ-retCS l (sTau () _)

