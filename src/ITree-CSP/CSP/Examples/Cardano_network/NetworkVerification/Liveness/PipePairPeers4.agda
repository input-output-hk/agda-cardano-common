-- forward τ simulation: the only impl τs are the loop re-entry sils
ccFwdT : (l : Link) → ∀ {p q p′} → CSCRel l p q → p ─[ τ ]─► p′
       → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × CSCRel l p′ q′)
ccFwdT l cIdle st = ⊥-elim (noτ-ibCS l (cCli l CS.stIdle) refl st)
ccFwdT l cAwait st = ⊥-elim (noτ-ibCS l (cCli l CS.stCanAwait) refl st)
ccFwdT l cMust st = ⊥-elim (noτ-ibCS l (cCli l CS.stMustReply) refl st)
ccFwdT l cInt st = ⊥-elim (noτ-ibCS l (cCli l CS.stIntersect) refl st)
ccFwdT l cDone st = ⊥-elim (noτ-retCS l st)
ccFwdT l mIdle (sSil refl) = _ , wτ τ*-refl , cIdle
ccFwdT l mIdle (sTau () _)
ccFwdT l mAwait (sSil refl) = _ , wτ τ*-refl , cAwait
ccFwdT l mAwait (sTau () _)
ccFwdT l mMust (sSil refl) = _ , wτ τ*-refl , cMust
ccFwdT l mMust (sTau () _)
ccFwdT l mInt (sSil refl) = _ , wτ τ*-refl , cInt
ccFwdT l mInt (sTau () _)
ccFwdT l mDone (sSil refl) = _ , wτ τ*-refl , cDone
ccFwdT l mDone (sTau () _)
ccFwdT l iWreq st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) valReq (SrcOpC.Ret (inj₁ CS.stCanAwait))) refl st)
ccFwdT l (iWfi pts) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) (valFi pts) (SrcOpC.Ret (inj₁ CS.stIntersect))) refl st)
ccFwdT l iWdone st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l hi) valDone (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone)))) refl st)
ccFwdT l iDdone st = ⊥-elim (noτ-ibCS l (SrcOpC.Prefix₀ (CS.doneCS l hi) (SrcOpC.Ret (inj₁ CS.stDone))) refl st)
ccFwdT l (iArf ht) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollforward) ht (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
ccFwdT l (iArb pt) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSRollback) pt (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
ccFwdT l (iAif pt) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-× ⦄ (CS.apiCSev l hi recvCSIntersectFound) pt (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
ccFwdT l (iAin tp) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.apiCSev l hi recvCSIntersectNotFound) tp (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
ccFwdT l cDead (sSil ())
ccFwdT l cDead (sTau refl ())

