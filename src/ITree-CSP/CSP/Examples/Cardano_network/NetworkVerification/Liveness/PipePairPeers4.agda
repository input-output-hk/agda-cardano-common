specNoτCS l ccIdle (sSil ())
specNoτCS l ccIdle (sTau refl ())
specNoτCS l ccWreq (sSil ())
specNoτCS l ccWreq (sTau refl ())
specNoτCS l ccAwait (sSil ())
specNoτCS l ccAwait (sTau refl ())
specNoτCS l (ccWfi pts) (sSil ())
specNoτCS l (ccWfi pts) (sTau refl ())
specNoτCS l ccInt (sSil ())
specNoτCS l ccInt (sTau refl ())
specNoτCS l ccWdone (sSil ())
specNoτCS l ccWdone (sTau refl ())
specNoτCS l ccDdone (sSil ())
specNoτCS l ccDdone (sTau refl ())
specNoτCS l ccMust (sSil ())
specNoτCS l ccMust (sTau refl ())
specNoτCS l (ccArf ht) (sSil ())
specNoτCS l (ccArf ht) (sTau refl ())
specNoτCS l (ccArb pt) (sSil ())
specNoτCS l (ccArb pt) (sTau refl ())
specNoτCS l (ccAif pt) (sSil ())
specNoτCS l (ccAif pt) (sTau refl ())
specNoτCS l (ccAin tp) (sSil ())
specNoτCS l (ccAin tp) (sTau refl ())
