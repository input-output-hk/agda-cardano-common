bfWbdImpl : (l : Link) → visOf (bsIB l (SrcOpB.Output (BF.sendBF l hi) valBD (SrcOpB.Ret (inj₁ BF.stIdle)))) (Payload , input l hi N2N_BlockFetch) valBD ≡ just (bsIB l (SrcOpB.Ret (inj₁ BF.stIdle)))
