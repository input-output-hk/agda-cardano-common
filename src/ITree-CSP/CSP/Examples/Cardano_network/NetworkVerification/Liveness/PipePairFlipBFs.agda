        → Σ[ q′ ∈ NetTree ] ((q ═[ ev lb ]═► q′) × BFSRel l p′ q′)
bfsFwdE F.zero sIdle (sRet ())
bfsFwdE F.zero sIdle (sVis {at = _ , input _ _ N2N_ChainSync} refl ())
bfsFwdE F.zero sIdle (sVis {at = _ , input _ _ N2N_BlockFetch} refl ())
