-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- the visible-menu application of a forced node (nothing on non-react shapes)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | ret _     = nothing
... | sil _     = nothing


------------------------------------------------------------------------
-- Item 3, SECOND PEER BISIM: `BFserverA linkBD hi ≈DR bfServerSpec linkBD hi`.
-- First replication of the KA-server DRFromRel template onto a second
-- protocol.  BF server is a pure echo with a genuine streaming loop
-- (bsStream ↔ bsWblk); 15-state relation (4 home react + 4 loop-re-entry
-- sils + 6 intermediate react + deadlock).  Value-gated firings (the api
-- reqBFRange emit and the four wire sends) use the `≟-diag` idiom; the
-- cross-module firing menu is Fin×Dir enumerated (finding 1).
------------------------------------------------------------------------

-- the BF server step function at the concrete (linkBD , hi) instance
bSrv : (l : Link) → BF.BFState → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)
bSrv l = BF.serverStep l hi

-- the BF server spec table at the concrete (linkBD , hi) instance
Tbs : (l : Link) → Table BFsPos
Tbs l = record { isFin = bfSfin ; nxt = bfSnxt l hi }

-- impl HOME state: the renamed iter at a server FSM position
bsI : (l : Link) → BF.BFState → NetTree
bsI l q = RenBF.renameMap (SrcOpB.iter (bSrv l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
bsIB : (l : Link) → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr) → NetTree
bsIB l t = RenBF.renameMap (SrcOpB.iter-bind t (bSrv l))

-- x ≟ x computes to yes refl for the ChainRange DecEq (repo ≟-diag idiom)
≟-diagCR : (x : ChainRange) → (x ≟ x) ≡ yes refl
≟-diagCR x = ≡-≟-identity _≟_ refl

-- the four fixed wire-send payloads the server emits
valSB valNB valBD : Payload
valSB = (time₀ , FromResponder , length₀ , blockFetch MsgStartBatch)
valNB = (time₀ , FromResponder , length₀ , blockFetch MsgNoBlocks)
valBD = (time₀ , FromResponder , length₀ , blockFetch MsgBatchDone)
valBLK : Block → Payload
valBLK b = (time₀ , FromResponder , length₀ , blockFetch (MsgBlock b))

-- the BF-server bisimulation relation: reachable impl states ↔ spec positions
data BFSRel (l : Link) : NetTree → NetTree → Set₁ where
  sIdle : BFSRel l (bsI l BF.stIdle) (tableSpec (Tbs l) bsIdle)
  sBusy : BFSRel l (bsI l BF.stBusy) (tableSpec (Tbs l) bsBusy)
  sStrm : BFSRel l (bsI l BF.stStreaming) (tableSpec (Tbs l) bsStream)
  sDone : BFSRel l (bsI l BF.stDone) (tableSpec (Tbs l) bsTerm)
  mIdle : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stIdle))) (tableSpec (Tbs l) bsIdle)
  mBusy : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stBusy))) (tableSpec (Tbs l) bsBusy)
  mStrm : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stStreaming))) (tableSpec (Tbs l) bsStream)
  mDone : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stDone))) (tableSpec (Tbs l) bsTerm)
  iAreq : (r : ChainRange) → BFSRel l (bsIB l (SrcOpB.Output (BF.apiBFev l hi reqBFRange) r (SrcOpB.Ret (inj₁ BF.stBusy)))) (tableSpec (Tbs l) (bsAreq r))
  iDdone : BFSRel l (bsIB l (SrcOpB.Prefix₀ (BF.doneBF l hi) (SrcOpB.Ret (inj₁ BF.stDone)))) (tableSpec (Tbs l) bsDdone)
  iWsb : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l hi) valSB (SrcOpB.Ret (inj₁ BF.stStreaming)))) (tableSpec (Tbs l) bsWsb)
  iWnb : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l hi) valNB (SrcOpB.Ret (inj₁ BF.stIdle)))) (tableSpec (Tbs l) bsWnb)
  iWblk : (b : Block) → BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l hi) (valBLK b) (SrcOpB.Ret (inj₁ BF.stStreaming)))) (tableSpec (Tbs l) (bsWblk b))
  iWbd : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l hi) valBD (SrcOpB.Ret (inj₁ BF.stIdle)))) (tableSpec (Tbs l) bsWbd)
  sDead : BFSRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ-part) has no τ
noτ-ibBF : (l : Link) (Q : PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr))
           {vq : (at : AnyTypes BF.BFEv) → ContinueType at (Maybe (PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)))}
         → PTree.force Q ≡ react vq SrcOpB.∅t
         → ∀ {X} → bsIB l Q ─[ τ ]─► X → ⊥
noτ-ibBF l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibBF l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibBF l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenBF.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retBF : (l : Link) → ∀ {X} → bsI l BF.stDone ─[ τ ]─► X → ⊥
noτ-retBF l (sSil ())
noτ-retBF l (sTau () _)

-- the τ-free spec table has no τ at any position
specNoτBF : (l : Link) (q : BFsPos) {X : NetTree} → tableSpec (Tbs l) q ─[ τ ]─► X → ⊥
specNoτBF l bsIdle (sSil ())
specNoτBF l bsIdle (sTau refl ())
specNoτBF l (bsAreq r) (sSil ())
specNoτBF l (bsAreq r) (sTau refl ())
specNoτBF l bsBusy (sSil ())
specNoτBF l bsBusy (sTau refl ())
specNoτBF l bsDdone (sSil ())
specNoτBF l bsDdone (sTau refl ())
specNoτBF l bsWsb (sSil ())
specNoτBF l bsWsb (sTau refl ())
specNoτBF l bsStream (sSil ())
specNoτBF l bsStream (sTau refl ())
specNoτBF l bsWnb (sSil ())
specNoτBF l bsWnb (sTau refl ())
specNoτBF l (bsWblk b) (sSil ())
specNoτBF l (bsWblk b) (sTau refl ())
specNoτBF l bsWbd (sSil ())
specNoτBF l bsWbd (sTau refl ())
specNoτBF l bsTerm (sSil ())
specNoτBF l bsTerm (sTau () _)

-- value-gated firings: impl `Output` gate + spec `pl ≟` gate discharged by ≟-diag
bfAreqImpl : (l : Link) → (r : ChainRange) → visOf (bsIB l (SrcOpB.Output (BF.apiBFev l hi reqBFRange) r (SrcOpB.Ret (inj₁ BF.stBusy)))) (ChainRange , apiBF l hi reqBFRange) r ≡ just (bsIB l (SrcOpB.Ret (inj₁ BF.stBusy)))
bfAreqImpl F.zero r rewrite ≟-diagCR r = refl
bfAreqImpl (F.suc F.zero) r rewrite ≟-diagCR r = refl
bfAreqImpl (F.suc (F.suc F.zero)) r rewrite ≟-diagCR r = refl
bfAreqImpl (F.suc (F.suc (F.suc F.zero))) r rewrite ≟-diagCR r = refl
bfAreqSpec : (l : Link) → (r : ChainRange) → tMenu (Tbs l) (bsAreq r) (ChainRange , apiBF l hi reqBFRange) r ≡ just (tableSpec (Tbs l) bsBusy)
bfAreqSpec F.zero r rewrite ≟-diagCR r = refl
bfAreqSpec (F.suc F.zero) r rewrite ≟-diagCR r = refl
bfAreqSpec (F.suc (F.suc F.zero)) r rewrite ≟-diagCR r = refl
bfAreqSpec (F.suc (F.suc (F.suc F.zero))) r rewrite ≟-diagCR r = refl
bfWsbImpl : (l : Link) → visOf (bsIB l (SrcOpB.Output (BF.sendBF l hi) valSB (SrcOpB.Ret (inj₁ BF.stStreaming)))) (Payload , input l hi N2N_BlockFetch) valSB ≡ just (bsIB l (SrcOpB.Ret (inj₁ BF.stStreaming)))
bfWsbImpl F.zero rewrite ≟-diagP valSB = refl
bfWsbImpl (F.suc F.zero) rewrite ≟-diagP valSB = refl
bfWsbImpl (F.suc (F.suc F.zero)) rewrite ≟-diagP valSB = refl
bfWsbImpl (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valSB = refl
bfWsbSpec : (l : Link) → tMenu (Tbs l) bsWsb (Payload , input l hi N2N_BlockFetch) valSB ≡ just (tableSpec (Tbs l) bsStream)
bfWsbSpec F.zero rewrite ≟-diagP valSB = refl
bfWsbSpec (F.suc F.zero) rewrite ≟-diagP valSB = refl
bfWsbSpec (F.suc (F.suc F.zero)) rewrite ≟-diagP valSB = refl
bfWsbSpec (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valSB = refl
bfWnbImpl : (l : Link) → visOf (bsIB l (SrcOpB.Output (BF.sendBF l hi) valNB (SrcOpB.Ret (inj₁ BF.stIdle)))) (Payload , input l hi N2N_BlockFetch) valNB ≡ just (bsIB l (SrcOpB.Ret (inj₁ BF.stIdle)))
bfWnbImpl F.zero rewrite ≟-diagP valNB = refl
bfWnbImpl (F.suc F.zero) rewrite ≟-diagP valNB = refl
bfWnbImpl (F.suc (F.suc F.zero)) rewrite ≟-diagP valNB = refl
bfWnbImpl (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valNB = refl
bfWnbSpec : (l : Link) → tMenu (Tbs l) bsWnb (Payload , input l hi N2N_BlockFetch) valNB ≡ just (tableSpec (Tbs l) bsIdle)
bfWnbSpec F.zero rewrite ≟-diagP valNB = refl
bfWnbSpec (F.suc F.zero) rewrite ≟-diagP valNB = refl
bfWnbSpec (F.suc (F.suc F.zero)) rewrite ≟-diagP valNB = refl
bfWnbSpec (F.suc (F.suc (F.suc F.zero))) rewrite ≟-diagP valNB = refl
bfWblkImpl : (l : Link) → (b : Block) → visOf (bsIB l (SrcOpB.Output (BF.sendBF l hi) (valBLK b) (SrcOpB.Ret (inj₁ BF.stStreaming)))) (Payload , input l hi N2N_BlockFetch) (valBLK b) ≡ just (bsIB l (SrcOpB.Ret (inj₁ BF.stStreaming)))
bfWblkImpl F.zero b rewrite ≟-diagP (valBLK b) = refl
bfWblkImpl (F.suc F.zero) b rewrite ≟-diagP (valBLK b) = refl
bfWblkImpl (F.suc (F.suc F.zero)) b rewrite ≟-diagP (valBLK b) = refl
bfWblkImpl (F.suc (F.suc (F.suc F.zero))) b rewrite ≟-diagP (valBLK b) = refl
bfWblkSpec : (l : Link) → (b : Block) → tMenu (Tbs l) (bsWblk b) (Payload , input l hi N2N_BlockFetch) (valBLK b) ≡ just (tableSpec (Tbs l) bsStream)
bfWblkSpec F.zero b rewrite ≟-diagP (valBLK b) = refl
bfWblkSpec (F.suc F.zero) b rewrite ≟-diagP (valBLK b) = refl
bfWblkSpec (F.suc (F.suc F.zero)) b rewrite ≟-diagP (valBLK b) = refl
