------------------------------------------------------------------------
-- The `FSimFromRel` stability obligation.  The spec is a τ-free `tableSpec`
-- FSM, so the spec's τ*-run is always `τ*-refl` and the settled state is the
-- spec position itself (`λ _ _ → refl` proves `isStable` of a non-final table
-- node).  The five UNSTABLE impl states (four loop-re-entry `sil`s and the
-- terminated `ret`) discharge the hypothesis by `lower`.
------------------------------------------------------------------------

-- whenever the impl is stable, the spec settles at once with a smaller menu
bfsStab : (l : Link) → ∀ {p q} → BFSRel l p q → isStable p
        → Σ[ q′ ∈ NetTree ]
            ( (q ─[τ*]─► q′) × isStable q′
            × (∀ (e : Event√ (⊤ {0ℓ})) → Offers q′ e → Offers p e) )
bfsStab l sIdle      _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclIdle l
bfsStab l sBusy      _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclBusy l
bfsStab l sStrm      _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclStrm l
bfsStab l (iAreq r)  _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclAreq l r
bfsStab l iDdone     _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclDdone l
bfsStab l iWsb       _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclWsb l
bfsStab l iWnb       _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclWnb l
bfsStab l (iWblk b)  _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclWblk l b
bfsStab l iWbd       _  = _ , τ*-refl , (λ _ _ → refl) , bfsInclWbd l
bfsStab l sDead      _  = _ , τ*-refl , deadlock-stable , λ _ off → off
bfsStab l mIdle      st = ⊥-elim (lower st)
bfsStab l mBusy      st = ⊥-elim (lower st)
bfsStab l mStrm      st = ⊥-elim (lower st)
bfsStab l mDone      st = ⊥-elim (lower st)
bfsStab l sDone      st = ⊥-elim (lower st)

-- the ONE-WAY coinduction principle: forward steps + stability + impl-divergence
module BFSFS (l : Link) = FSimFromRel (BFSRel l) (bfsFwdE l) (bfsFwdT l) (bfsStab l) (bfsNdivL l)

-- the BF server spec failure-simulates the renamed BF server iter
bfServerFSim : (l : Link) → FSim (⊤ {0ℓ}) (BFserverA l hi) (bfServerSpec l hi)
bfServerFSim l = BFSFS.rel→fsim l sIdle

-- the one-way half of `bfServer≈DRhi`, via FSim only
bfServerSpec⊑FD : (l : Link) → bfServerSpec l hi ⊑FD BFserverA l hi
bfServerSpec⊑FD l = fsim→⊑FD (bfServerFSim l)

-- mechanical confirmation that this is the SECOND component of the ≈FD result
orientation-check : (l : Link) → bfServerSpec l hi ⊑FD BFserverA l hi
orientation-check l = proj₂ (drbisim→≈FD (bfServer≈DRhi l))
