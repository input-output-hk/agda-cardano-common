-- x ≟ x computes to yes refl for the Payload DecEq (repo ≟-diag idiom)
≟-diagP : (x : Payload) → (x ≟ x) ≡ yes refl
≟-diagP x = ≡-≟-identity _≟_ refl

-- x ≟ x computes to yes refl for List Point (instance pinned — CS leak break)
≟-diagLP : (x : List Point) → (_≟_ ⦃ DecEqI.DecEq-List ⦄ x x) ≡ yes refl
≟-diagLP x = ≡-≟-identity (_≟_ ⦃ DecEqI.DecEq-List ⦄) refl

-- the one-step successor of a react node under a visible offer (its menu)
visOf : NetTree → (at : AnyTypes (Net_Api Payload)) → proj₁ at → Maybe NetTree
visOf P at a with PTree.force P
... | react v _ = v at a
... | _         = nothing

-- the CS server step function at the concrete server direction (lo)
cSrv : (l : Link) → CS.CSState → PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr)
cSrv l = CS.serverStep l lo

-- the CS server spec table
Tcs : (l : Link) → Table CSsPos
Tcs l = record { isFin = csSfin ; nxt = csSnxt l lo }

-- impl HOME state: the renamed iter at a server FSM position
csI : (l : Link) → CS.CSState → NetTree
csI l q = RenCS.renameMap (SrcOpC.iter (cSrv l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
csIB : (l : Link) → PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr) → NetTree
csIB l t = RenCS.renameMap (SrcOpC.iter-bind t (cSrv l))

-- the fixed wire-send payloads the server emits (FromResponder)
valRF : Header × Tip → Payload
valRF (h , t) = (time₀ , FromResponder , length₀ , chainSync (MsgCSRollForward h t))
valRB : Point × Tip → Payload
valRB (pt , tp) = (time₀ , FromResponder , length₀ , chainSync (MsgCSRollBackward pt tp))
valAR : Payload
valAR = (time₀ , FromResponder , length₀ , chainSync MsgCSAwaitReply)
valIF : Point × Tip → Payload
valIF (pt , tp) = (time₀ , FromResponder , length₀ , chainSync (MsgCSIntersectFound pt tp))
valIN : Tip → Payload
valIN tp = (time₀ , FromResponder , length₀ , chainSync (MsgCSIntersectNotFound tp))

-- the CS-server bisimulation relation: reachable impl states ↔ spec positions
data CSSRel (l : Link) : NetTree → NetTree → Set₁ where
  sIdle : CSSRel l (csI l CS.stIdle) (tableSpec (Tcs l) csIdle)
  sCanAwait : CSSRel l (csI l CS.stCanAwait) (tableSpec (Tcs l) csCanAwait)
  sMust : CSSRel l (csI l CS.stMustReply) (tableSpec (Tcs l) csMust)
  sInt : CSSRel l (csI l CS.stIntersect) (tableSpec (Tcs l) csInt)
  sDone : CSSRel l (csI l CS.stDone) (tableSpec (Tcs l) csTerm)
  mIdle : CSSRel l (csIB l (SrcOpC.Ret (inj₁ CS.stIdle))) (tableSpec (Tcs l) csIdle)
  mCanAwait : CSSRel l (csIB l (SrcOpC.Ret (inj₁ CS.stCanAwait))) (tableSpec (Tcs l) csCanAwait)
  mMust : CSSRel l (csIB l (SrcOpC.Ret (inj₁ CS.stMustReply))) (tableSpec (Tcs l) csMust)
  mInt : CSSRel l (csIB l (SrcOpC.Ret (inj₁ CS.stIntersect))) (tableSpec (Tcs l) csInt)
  mDone : CSSRel l (csIB l (SrcOpC.Ret (inj₁ CS.stDone))) (tableSpec (Tcs l) csTerm)
  iAreq : CSSRel l (csIB l (SrcOpC.Prefix₀ (CS.apiCSev l lo reqCSRequestNext) (SrcOpC.Ret (inj₁ CS.stCanAwait)))) (tableSpec (Tcs l) csAreq)
  iAfi : (pts : List Point) → CSSRel l (csIB l (SrcOpC.Output ⦃ DecEqI.DecEq-List ⦄ (CS.apiCSev l lo reqCSFindIntersect) pts (SrcOpC.Ret (inj₁ CS.stIntersect)))) (tableSpec (Tcs l) (csAfi pts))
  iDdone : CSSRel l (csIB l (SrcOpC.Prefix₀ (CS.doneCS l lo) (SrcOpC.Ret (inj₁ CS.stDone)))) (tableSpec (Tcs l) csDdone)
  iWrf : (ht : Header × Tip) → CSSRel l (csIB l (SrcOpC.Output (CS.sendCS l lo) (valRF ht) (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcs l) (csWrf ht))
  iWrb : (pt : Point × Tip) → CSSRel l (csIB l (SrcOpC.Output (CS.sendCS l lo) (valRB pt) (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcs l) (csWrb pt))
  iWar : CSSRel l (csIB l (SrcOpC.Output (CS.sendCS l lo) valAR (SrcOpC.Ret (inj₁ CS.stMustReply)))) (tableSpec (Tcs l) csWar)
  iWif : (pt : Point × Tip) → CSSRel l (csIB l (SrcOpC.Output (CS.sendCS l lo) (valIF pt) (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcs l) (csWif pt))
  iWin : (tp : Tip) → CSSRel l (csIB l (SrcOpC.Output (CS.sendCS l lo) (valIN tp) (SrcOpC.Ret (inj₁ CS.stIdle)))) (tableSpec (Tcs l) (csWin tp))
  sDead : CSSRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ) has no τ
noτ-ibCS : (l : Link) (Q : PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr))
           {vq : (at : AnyTypes CS.CSEv) → ContinueType at (Maybe (PTree CS.CSEv (ExtI CS.CSEv) (CS.CSState ⊎ CS.Rr)))}
         → PTree.force Q ≡ react vq SrcOpC.∅t
         → ∀ {X} → csIB l Q ─[ τ ]─► X → ⊥
noτ-ibCS l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibCS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibCS l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenCS.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retCS : (l : Link) → ∀ {X} → csI l CS.stDone ─[ τ ]─► X → ⊥
noτ-retCS l (sSil ())
noτ-retCS l (sTau () _)

-- the τ-free spec table has no τ at any position
specNoτCS : (l : Link) (q : CSsPos) {X : NetTree} → tableSpec (Tcs l) q ─[ τ ]─► X → ⊥
specNoτCS l csIdle (sSil ())
specNoτCS l csIdle (sTau refl ())
specNoτCS l csAreq (sSil ())
specNoτCS l csAreq (sTau refl ())
specNoτCS l csCanAwait (sSil ())
specNoτCS l csCanAwait (sTau refl ())
specNoτCS l (csAfi pts) (sSil ())
specNoτCS l (csAfi pts) (sTau refl ())
specNoτCS l csInt (sSil ())
specNoτCS l csInt (sTau refl ())
specNoτCS l csDdone (sSil ())
specNoτCS l csDdone (sTau refl ())
specNoτCS l csMust (sSil ())
specNoτCS l csMust (sTau refl ())
specNoτCS l (csWrf ht) (sSil ())
specNoτCS l (csWrf ht) (sTau refl ())
specNoτCS l (csWrb pt) (sSil ())
specNoτCS l (csWrb pt) (sTau refl ())
specNoτCS l csWar (sSil ())
specNoτCS l csWar (sTau refl ())
specNoτCS l (csWif pt) (sSil ())
specNoτCS l (csWif pt) (sTau refl ())
specNoτCS l (csWin tp) (sSil ())
