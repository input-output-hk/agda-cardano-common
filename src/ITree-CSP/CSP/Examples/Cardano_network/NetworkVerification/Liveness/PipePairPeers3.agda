-- forward τ simulation: the only impl τs are the loop re-entry sils
csFwdT : (l : Link) → ∀ {p q p′} → CSSRel l p q → p ─[ τ ]─► p′
       → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × CSSRel l p′ q′)
csFwdT l sIdle st = ⊥-elim (noτ-ibCS l (cSrv l CS.stIdle) refl st)
csFwdT l sCanAwait st = ⊥-elim (noτ-ibCS l (cSrv l CS.stCanAwait) refl st)
csFwdT l sMust st = ⊥-elim (noτ-ibCS l (cSrv l CS.stMustReply) refl st)
csFwdT l sInt st = ⊥-elim (noτ-ibCS l (cSrv l CS.stIntersect) refl st)
csFwdT l sDone st = ⊥-elim (noτ-retCS l st)
csFwdT l mIdle (sSil refl) = _ , wτ τ*-refl , sIdle
csFwdT l mIdle (sTau () _)
csFwdT l mCanAwait (sSil refl) = _ , wτ τ*-refl , sCanAwait
csFwdT l mCanAwait (sTau () _)
csFwdT l mMust (sSil refl) = _ , wτ τ*-refl , sMust
csFwdT l mMust (sTau () _)
csFwdT l mInt (sSil refl) = _ , wτ τ*-refl , sInt
csFwdT l mInt (sTau () _)
csFwdT l mDone (sSil refl) = _ , wτ τ*-refl , sDone
csFwdT l mDone (sTau () _)
csFwdT l iAreq st = ⊥-elim (noτ-ibCS l (SrcOpC.Prefix₀ (CS.apiCSev l lo reqCSRequestNext) (SrcOpC.Ret (inj₁ CS.stCanAwait))) refl st)
csFwdT l (iAfi pts) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-List ⦄ (CS.apiCSev l lo reqCSFindIntersect) pts (SrcOpC.Ret (inj₁ CS.stIntersect))) refl st)
csFwdT l iDdone st = ⊥-elim (noτ-ibCS l (SrcOpC.Prefix₀ (CS.doneCS l lo) (SrcOpC.Ret (inj₁ CS.stDone))) refl st)
csFwdT l (iWrf ht) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valRF ht) (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
csFwdT l (iWrb pt) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valRB pt) (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
csFwdT l iWar st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) valAR (SrcOpC.Ret (inj₁ CS.stMustReply))) refl st)
csFwdT l (iWif pt) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valIF pt) (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
csFwdT l (iWin tp) st = ⊥-elim (noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valIN tp) (SrcOpC.Ret (inj₁ CS.stIdle))) refl st)
csFwdT l sDead (sSil ())
csFwdT l sDead (sTau refl ())

