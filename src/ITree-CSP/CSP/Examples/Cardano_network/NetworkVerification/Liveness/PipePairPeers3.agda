-- backward τ simulation: the spec is τ-free (vacuous)
csBwdT : (l : Link) → ∀ {p q q′} → CSSRel l p q → q ─[ τ ]─► q′
       → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × CSSRel l p′ q′)
csBwdT l sIdle st = ⊥-elim (specNoτCS l csIdle st)
csBwdT l sCanAwait st = ⊥-elim (specNoτCS l csCanAwait st)
csBwdT l sMust st = ⊥-elim (specNoτCS l csMust st)
csBwdT l sInt st = ⊥-elim (specNoτCS l csInt st)
csBwdT l sDone st = ⊥-elim (specNoτCS l csTerm st)
csBwdT l mIdle st = ⊥-elim (specNoτCS l csIdle st)
csBwdT l mCanAwait st = ⊥-elim (specNoτCS l csCanAwait st)
csBwdT l mMust st = ⊥-elim (specNoτCS l csMust st)
csBwdT l mInt st = ⊥-elim (specNoτCS l csInt st)
csBwdT l mDone st = ⊥-elim (specNoτCS l csTerm st)
csBwdT l iAreq st = ⊥-elim (specNoτCS l csAreq st)
csBwdT l (iAfi pts) st = ⊥-elim (specNoτCS l (csAfi pts) st)
csBwdT l iDdone st = ⊥-elim (specNoτCS l csDdone st)
csBwdT l (iWrf ht) st = ⊥-elim (specNoτCS l (csWrf ht) st)
csBwdT l (iWrb pt) st = ⊥-elim (specNoτCS l (csWrb pt) st)
csBwdT l iWar st = ⊥-elim (specNoτCS l csWar st)
csBwdT l (iWif pt) st = ⊥-elim (specNoτCS l (csWif pt) st)
csBwdT l (iWin tp) st = ⊥-elim (specNoτCS l (csWin tp) st)
csBwdT l sDead (sSil ())
csBwdT l sDead (sTau refl ())

-- the impl never diverges: stable states have no τ; sils τ once into a stable one
csNdivL : (l : Link) → ∀ {p q} → CSSRel l p q → Diverges p → ⊥
csNdivL l sIdle dv = noτ-ibCS l (cSrv l CS.stIdle) refl (dv .Diverges.step)
csNdivL l sCanAwait dv = noτ-ibCS l (cSrv l CS.stCanAwait) refl (dv .Diverges.step)
csNdivL l sMust dv = noτ-ibCS l (cSrv l CS.stMustReply) refl (dv .Diverges.step)
csNdivL l sInt dv = noτ-ibCS l (cSrv l CS.stIntersect) refl (dv .Diverges.step)
csNdivL l sDone dv = noτ-retCS l (dv .Diverges.step)
csNdivL l mIdle dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cSrv l CS.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
csNdivL l mCanAwait dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cSrv l CS.stCanAwait) refl (rest .Diverges.step)
... | _ | sTau () _ | _
csNdivL l mMust dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cSrv l CS.stMustReply) refl (rest .Diverges.step)
... | _ | sTau () _ | _
csNdivL l mInt dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibCS l (cSrv l CS.stIntersect) refl (rest .Diverges.step)
... | _ | sTau () _ | _
csNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retCS l (rest .Diverges.step)
... | _ | sTau () _ | _
csNdivL l iAreq dv = noτ-ibCS l (SrcOpC.Prefix₀ (CS.apiCSev l lo reqCSRequestNext) (SrcOpC.Ret (inj₁ CS.stCanAwait))) refl (dv .Diverges.step)
csNdivL l (iAfi pts) dv = noτ-ibCS l (SrcOpC.Output ⦃ DecEqI.DecEq-List ⦄ (CS.apiCSev l lo reqCSFindIntersect) pts (SrcOpC.Ret (inj₁ CS.stIntersect))) refl (dv .Diverges.step)
csNdivL l iDdone dv = noτ-ibCS l (SrcOpC.Prefix₀ (CS.doneCS l lo) (SrcOpC.Ret (inj₁ CS.stDone))) refl (dv .Diverges.step)
csNdivL l (iWrf ht) dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valRF ht) (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
csNdivL l (iWrb pt) dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valRB pt) (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
csNdivL l iWar dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) valAR (SrcOpC.Ret (inj₁ CS.stMustReply))) refl (dv .Diverges.step)
csNdivL l (iWif pt) dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valIF pt) (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
csNdivL l (iWin tp) dv = noτ-ibCS l (SrcOpC.Output (CS.sendCS l lo) (valIN tp) (SrcOpC.Ret (inj₁ CS.stIdle))) refl (dv .Diverges.step)
csNdivL l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
csNdivR : (l : Link) → ∀ {p q} → CSSRel l p q → Diverges q → ⊥
csNdivR l sIdle dv = specNoτCS l csIdle (dv .Diverges.step)
csNdivR l sCanAwait dv = specNoτCS l csCanAwait (dv .Diverges.step)
csNdivR l sMust dv = specNoτCS l csMust (dv .Diverges.step)
csNdivR l sInt dv = specNoτCS l csInt (dv .Diverges.step)
csNdivR l sDone dv = specNoτCS l csTerm (dv .Diverges.step)
csNdivR l mIdle dv = specNoτCS l csIdle (dv .Diverges.step)
csNdivR l mCanAwait dv = specNoτCS l csCanAwait (dv .Diverges.step)
csNdivR l mMust dv = specNoτCS l csMust (dv .Diverges.step)
csNdivR l mInt dv = specNoτCS l csInt (dv .Diverges.step)
csNdivR l mDone dv = specNoτCS l csTerm (dv .Diverges.step)
csNdivR l iAreq dv = specNoτCS l csAreq (dv .Diverges.step)
csNdivR l (iAfi pts) dv = specNoτCS l (csAfi pts) (dv .Diverges.step)
csNdivR l iDdone dv = specNoτCS l csDdone (dv .Diverges.step)
csNdivR l (iWrf ht) dv = specNoτCS l (csWrf ht) (dv .Diverges.step)
csNdivR l (iWrb pt) dv = specNoτCS l (csWrb pt) (dv .Diverges.step)
csNdivR l iWar dv = specNoτCS l csWar (dv .Diverges.step)
csNdivR l (iWif pt) dv = specNoτCS l (csWif pt) (dv .Diverges.step)
csNdivR l (iWin tp) dv = specNoτCS l (csWin tp) (dv .Diverges.step)
csNdivR l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the CS-server relation
module CSSDR (l : Link) = DRFromRel (CSSRel l) (csFwdE l) (csFwdT l) (csBwdE l) (csBwdT l) (csNdivL l) (csNdivR l)

-- THE CS-SERVER PEER BISIM: the renamed CS server iter ≈DR its τ-free spec table
csServer≈DR : (l : Link) → CSserverA l lo ≈DR csServerSpec l lo
csServer≈DR l = CSSDR.rel→dr l sIdle
