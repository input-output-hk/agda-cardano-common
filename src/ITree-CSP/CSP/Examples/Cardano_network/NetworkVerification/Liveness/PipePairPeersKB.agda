-- rA: spec ksClient — the two wire-output edges; impl home state fires directly
-- rB: spec ksResp — impl (sil state) pre-τs to the response node, then fires
-- rC: spec ksResp — impl response node fires directly
-- rD: spec ksClient — impl (sil state) pre-τs home, then fires
-- rE: spec ksDdone — the done edge; impl done node fires directly
-- rF: spec ksTerm (√) — impl pre-τs to its ret state, then √s
-- rG: spec ksTerm (√) — impl ret state √s directly
-- rH: deadlock offers nothing

-- backward τ simulation: the spec is τ-free (vacuous)
kasBwdT : (l : Link) → ∀ {p q q′} → KASRel l p q → q ─[ τ ]─► q′
        → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × KASRel l p′ q′)
kasBwdT l rA     st = ⊥-elim (specNoτ l ksClient st)
kasBwdT l (rB c) st = ⊥-elim (specNoτ l (ksResp c) st)
kasBwdT l (rC c) st = ⊥-elim (specNoτ l (ksResp c) st)
kasBwdT l rD     st = ⊥-elim (specNoτ l ksClient st)
kasBwdT l rE     st = ⊥-elim (specNoτ l ksDdone st)
kasBwdT l rF     st = ⊥-elim (specNoτ l ksTerm st)
kasBwdT l rG     st = ⊥-elim (specNoτ l ksTerm st)
kasBwdT l rH     (sSil ())
kasBwdT l rH     (sTau refl ())

-- the impl never diverges: stable states have no τ; sil states τ once into a stable one
kasNdivL : (l : Link) → ∀ {p q} → KASRel l p q → Diverges p → ⊥
kasNdivL l rA     dv = noτ-ib l (kSrv l stClient) refl (dv .Diverges.step)
kasNdivL l (rB c) dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ib l (kSrv l (stServer c)) refl (rest .Diverges.step)
... | _ | sTau () _ | _
kasNdivL l (rC c) dv = noτ-ib l (kSrv l (stServer c)) refl (dv .Diverges.step)
kasNdivL l rD     dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ib l (kSrv l stClient) refl (rest .Diverges.step)
... | _ | sTau () _ | _
kasNdivL l rE     dv = noτ-ib l (SrcOp.Prefix₀ (doneKA l lo) (SrcOp.Ret (inj₁ stDone))) refl (dv .Diverges.step)
kasNdivL l rF     dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ret l (rest .Diverges.step)
... | _ | sTau () _ | _
kasNdivL l rG     dv = noτ-ret l (dv .Diverges.step)
kasNdivL l rH     dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
kasNdivR : (l : Link) → ∀ {p q} → KASRel l p q → Diverges q → ⊥
kasNdivR l rA     dv = specNoτ l ksClient (dv .Diverges.step)
kasNdivR l (rB c) dv = specNoτ l (ksResp c) (dv .Diverges.step)
kasNdivR l (rC c) dv = specNoτ l (ksResp c) (dv .Diverges.step)
kasNdivR l rD     dv = specNoτ l ksClient (dv .Diverges.step)
kasNdivR l rE     dv = specNoτ l ksDdone (dv .Diverges.step)
kasNdivR l rF     dv = specNoτ l ksTerm (dv .Diverges.step)
kasNdivR l rG     dv = specNoτ l ksTerm (dv .Diverges.step)
kasNdivR l rH     dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the KA-server relation
module KASDR (l : Link) = DRFromRel (KASRel l) (kasFwdE l) (kasFwdT l) (kasBwdE l) (kasBwdT l) (kasNdivL l) (kasNdivR l)

-- THE FIRST PEER BISIM: the renamed KA server iter ≈DR its τ-free spec table
kaServer≈DR : (l : Link) → KAserverA l lo ≈DR kaServerSpec l lo
kaServer≈DR l = KASDR.rel→dr l rA

------------------------------------------------------------------------
-- Item 3, SECOND PEER BISIM: `BFserverA linkBD lo ≈DR bfServerSpec linkBD lo`.
-- First replication of the KA-server DRFromRel template onto a second
-- protocol.  BF server is a pure echo with a genuine streaming loop
-- (bsStream ↔ bsWblk); 15-state relation (4 home react + 4 loop-re-entry
-- sils + 6 intermediate react + deadlock).  Value-gated firings (the api
-- reqBFRange emit and the four wire sends) use the `≟-diag` idiom; the
-- cross-module firing menu is Fin×Dir enumerated (finding 1).
------------------------------------------------------------------------

-- the BF server step function at the concrete (linkBD , lo) instance
bSrv : (l : Link) → BF.BFState → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)
bSrv l = BF.serverStep l lo

-- the BF server spec table at the concrete (linkBD , lo) instance
Tbs : (l : Link) → Table BFsPos
Tbs l = record { isFin = bfSfin ; nxt = bfSnxt l lo }

-- impl HOME state: the renamed iter at a server FSM position
bsI : (l : Link) → BF.BFState → NetTree
bsI l q = RenBF.renameMap (SrcOpB.iter (bSrv l) q)

-- impl MID state: the renamed iter-bind of a residual body tree
bsIB : (l : Link) → PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr) → NetTree
bsIB l t = RenBF.renameMap (SrcOpB.iter-bind t (bSrv l))

-- x ≟ x computes to yes refl for the ChainRange DecEq (repo ≟-diag idiom)
≟-diagCR : (x : ChainRange) → (x ≟ x) ≡ yes refl
≟-diagCR x = ≡-≟-identity _≟_ refl

-- the four fixed wire-send payloads the server emits
valSB valNB valBD : Payload
valSB = (time₀ , FromResponder , length₀ , blockFetch MsgStartBatch)
valNB = (time₀ , FromResponder , length₀ , blockFetch MsgNoBlocks)
valBD = (time₀ , FromResponder , length₀ , blockFetch MsgBatchDone)
valBLK : Block → Payload
valBLK b = (time₀ , FromResponder , length₀ , blockFetch (MsgBlock b))

-- the BF-server bisimulation relation: reachable impl states ↔ spec positions
data BFSRel (l : Link) : NetTree → NetTree → Set₁ where
  sIdle : BFSRel l (bsI l BF.stIdle) (tableSpec (Tbs l) bsIdle)
  sBusy : BFSRel l (bsI l BF.stBusy) (tableSpec (Tbs l) bsBusy)
  sStrm : BFSRel l (bsI l BF.stStreaming) (tableSpec (Tbs l) bsStream)
  sDone : BFSRel l (bsI l BF.stDone) (tableSpec (Tbs l) bsTerm)
  mIdle : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stIdle))) (tableSpec (Tbs l) bsIdle)
  mBusy : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stBusy))) (tableSpec (Tbs l) bsBusy)
  mStrm : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stStreaming))) (tableSpec (Tbs l) bsStream)
  mDone : BFSRel l (bsIB l (SrcOpB.Ret (inj₁ BF.stDone))) (tableSpec (Tbs l) bsTerm)
  iAreq : (r : ChainRange) → BFSRel l (bsIB l (SrcOpB.Output (BF.apiBFev l lo reqBFRange) r (SrcOpB.Ret (inj₁ BF.stBusy)))) (tableSpec (Tbs l) (bsAreq r))
  iDdone : BFSRel l (bsIB l (SrcOpB.Prefix₀ (BF.doneBF l lo) (SrcOpB.Ret (inj₁ BF.stDone)))) (tableSpec (Tbs l) bsDdone)
  iWsb : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l lo) valSB (SrcOpB.Ret (inj₁ BF.stStreaming)))) (tableSpec (Tbs l) bsWsb)
  iWnb : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l lo) valNB (SrcOpB.Ret (inj₁ BF.stIdle)))) (tableSpec (Tbs l) bsWnb)
  iWblk : (b : Block) → BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l lo) (valBLK b) (SrcOpB.Ret (inj₁ BF.stStreaming)))) (tableSpec (Tbs l) (bsWblk b))
  iWbd : BFSRel l (bsIB l (SrcOpB.Output (BF.sendBF l lo) valBD (SrcOpB.Ret (inj₁ BF.stIdle)))) (tableSpec (Tbs l) bsWbd)
  sDead : BFSRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ-part) has no τ
noτ-ibBF : (l : Link) (Q : PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr))
           {vq : (at : AnyTypes BF.BFEv) → ContinueType at (Maybe (PTree BF.BFEv (ExtI BF.BFEv) (BF.BFState ⊎ Rr)))}
         → PTree.force Q ≡ react vq SrcOpB.∅t
         → ∀ {X} → bsIB l Q ─[ τ ]─► X → ⊥
noτ-ibBF l Q eqQ (sSil eqf) with PTree.force Q | eqQ | eqf
... | _ | refl | ()
noτ-ibBF l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) with PTree.force Q | eqQ
noτ-ibBF l Q eqQ (sTau {i = A , eι₂} {a = a} eqf br) | _ | refl
  with RenBF.extBwd eι₂
     | subst (λ g → g (A , eι₂) a ≡ just _) (sym (proj₂ (react-injective eqf))) br
... | nothing  | ()
... | just eι₁ | ()

-- the terminated impl home state (√) has no τ
noτ-retBF : (l : Link) → ∀ {X} → bsI l BF.stDone ─[ τ ]─► X → ⊥
noτ-retBF l (sSil ())
noτ-retBF l (sTau () _)

-- the τ-free spec table has no τ at any position
specNoτBF : (l : Link) (q : BFsPos) {X : NetTree} → tableSpec (Tbs l) q ─[ τ ]─► X → ⊥
specNoτBF l bsIdle (sSil ())
specNoτBF l bsIdle (sTau refl ())
specNoτBF l (bsAreq r) (sSil ())
specNoτBF l (bsAreq r) (sTau refl ())
specNoτBF l bsBusy (sSil ())
specNoτBF l bsBusy (sTau refl ())
specNoτBF l bsDdone (sSil ())
specNoτBF l bsDdone (sTau refl ())
specNoτBF l bsWsb (sSil ())
specNoτBF l bsWsb (sTau refl ())
specNoτBF l bsStream (sSil ())
specNoτBF l bsStream (sTau refl ())
specNoτBF l bsWnb (sSil ())
specNoτBF l bsWnb (sTau refl ())
specNoτBF l (bsWblk b) (sSil ())
specNoτBF l (bsWblk b) (sTau refl ())
specNoτBF l bsWbd (sSil ())
specNoτBF l bsWbd (sTau refl ())
specNoτBF l bsTerm (sSil ())
specNoτBF l bsTerm (sTau () _)

