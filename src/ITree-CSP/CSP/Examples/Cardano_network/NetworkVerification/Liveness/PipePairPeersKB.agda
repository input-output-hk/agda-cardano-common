-- backward τ simulation: the spec is τ-free (vacuous)
bfsBwdT : (l : Link) → ∀ {p q q′} → BFSRel l p q → q ─[ τ ]─► q′
        → Σ[ p′ ∈ NetTree ] ((p ═[ τ ]═► p′) × BFSRel l p′ q′)
bfsBwdT l sIdle st = ⊥-elim (specNoτBF l bsIdle st)
bfsBwdT l sBusy st = ⊥-elim (specNoτBF l bsBusy st)
bfsBwdT l sStrm st = ⊥-elim (specNoτBF l bsStream st)
bfsBwdT l sDone st = ⊥-elim (specNoτBF l bsTerm st)
bfsBwdT l mIdle st = ⊥-elim (specNoτBF l bsIdle st)
bfsBwdT l mBusy st = ⊥-elim (specNoτBF l bsBusy st)
bfsBwdT l mStrm st = ⊥-elim (specNoτBF l bsStream st)
bfsBwdT l mDone st = ⊥-elim (specNoτBF l bsTerm st)
bfsBwdT l (iAreq r) st = ⊥-elim (specNoτBF l (bsAreq r) st)
bfsBwdT l iDdone st = ⊥-elim (specNoτBF l bsDdone st)
bfsBwdT l iWsb st = ⊥-elim (specNoτBF l bsWsb st)
bfsBwdT l iWnb st = ⊥-elim (specNoτBF l bsWnb st)
bfsBwdT l (iWblk b) st = ⊥-elim (specNoτBF l (bsWblk b) st)
bfsBwdT l iWbd st = ⊥-elim (specNoτBF l bsWbd st)
bfsBwdT l sDead (sSil ())
bfsBwdT l sDead (sTau refl ())

-- the impl never diverges: stable states have no τ; sil states τ once into a stable one
bfsNdivL : (l : Link) → ∀ {p q} → BFSRel l p q → Diverges p → ⊥
bfsNdivL l sIdle dv = noτ-ibBF l (bSrv l BF.stIdle) refl (dv .Diverges.step)
bfsNdivL l sBusy dv = noτ-ibBF l (bSrv l BF.stBusy) refl (dv .Diverges.step)
bfsNdivL l sStrm dv = noτ-ibBF l (bSrv l BF.stStreaming) refl (dv .Diverges.step)
bfsNdivL l sDone dv = noτ-retBF l (dv .Diverges.step)
bfsNdivL l mIdle dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBF l (bSrv l BF.stIdle) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfsNdivL l mBusy dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBF l (bSrv l BF.stBusy) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfsNdivL l mStrm dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-ibBF l (bSrv l BF.stStreaming) refl (rest .Diverges.step)
... | _ | sTau () _ | _
bfsNdivL l mDone dv with dv .Diverges.next | dv .Diverges.step | dv .Diverges.rest
... | _ | sSil refl | rest = noτ-retBF l (rest .Diverges.step)
... | _ | sTau () _ | _
bfsNdivL l (iAreq r) dv = noτ-ibBF l (SrcOpB.Output (BF.apiBFev l lo reqBFRange) r (SrcOpB.Ret (inj₁ BF.stBusy))) refl (dv .Diverges.step)
bfsNdivL l iDdone dv = noτ-ibBF l (SrcOpB.Prefix₀ (BF.doneBF l lo) (SrcOpB.Ret (inj₁ BF.stDone))) refl (dv .Diverges.step)
bfsNdivL l iWsb dv = noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valSB (SrcOpB.Ret (inj₁ BF.stStreaming))) refl (dv .Diverges.step)
bfsNdivL l iWnb dv = noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valNB (SrcOpB.Ret (inj₁ BF.stIdle))) refl (dv .Diverges.step)
bfsNdivL l (iWblk b) dv = noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) (valBLK b) (SrcOpB.Ret (inj₁ BF.stStreaming))) refl (dv .Diverges.step)
bfsNdivL l iWbd dv = noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valBD (SrcOpB.Ret (inj₁ BF.stIdle))) refl (dv .Diverges.step)
bfsNdivL l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the spec never diverges: it is τ-free at every position
bfsNdivR : (l : Link) → ∀ {p q} → BFSRel l p q → Diverges q → ⊥
bfsNdivR l sIdle dv = specNoτBF l bsIdle (dv .Diverges.step)
bfsNdivR l sBusy dv = specNoτBF l bsBusy (dv .Diverges.step)
bfsNdivR l sStrm dv = specNoτBF l bsStream (dv .Diverges.step)
bfsNdivR l sDone dv = specNoτBF l bsTerm (dv .Diverges.step)
bfsNdivR l mIdle dv = specNoτBF l bsIdle (dv .Diverges.step)
bfsNdivR l mBusy dv = specNoτBF l bsBusy (dv .Diverges.step)
bfsNdivR l mStrm dv = specNoτBF l bsStream (dv .Diverges.step)
bfsNdivR l mDone dv = specNoτBF l bsTerm (dv .Diverges.step)
bfsNdivR l (iAreq r) dv = specNoτBF l (bsAreq r) (dv .Diverges.step)
bfsNdivR l iDdone dv = specNoτBF l bsDdone (dv .Diverges.step)
bfsNdivR l iWsb dv = specNoτBF l bsWsb (dv .Diverges.step)
bfsNdivR l iWnb dv = specNoτBF l bsWnb (dv .Diverges.step)
bfsNdivR l (iWblk b) dv = specNoτBF l (bsWblk b) (dv .Diverges.step)
bfsNdivR l iWbd dv = specNoτBF l bsWbd (dv .Diverges.step)
bfsNdivR l sDead dv = deadlock-no-τ (dv .Diverges.step)

-- the coinduction principle instantiated with the BF-server relation
module BFSDR (l : Link) = DRFromRel (BFSRel l) (bfsFwdE l) (bfsFwdT l) (bfsBwdE l) (bfsBwdT l) (bfsNdivL l) (bfsNdivR l)

-- THE SECOND PEER BISIM: the renamed BF server iter ≈DR its τ-free spec table
bfServer≈DR : (l : Link) → BFserverA l lo ≈DR bfServerSpec l lo
bfServer≈DR l = BFSDR.rel→dr l sIdle


------------------------------------------------------------------------
-- CLIENT GATE-REFLECTION design (KA client, the Part-8 concrete instance).
--
-- Part 8 flagged the client value-branch as a bisim risk: the KA client's
-- `stServer c` menu has an INTERNAL gate `cookieReq ≟ cookieRsp`
-- (`KeepAlive.clientStep`) whose two outcomes — loop back (kcClient) vs the
-- errCookie branch (kcErr c c′) — must reach DISTINCT spec targets, unlike
-- `OffersOnly` which only needed both to confine.
--
-- FINDING (positively resolves the risk at goalBD/goalCD scope): in the
-- concrete `p` (FourNodeDiamond), `Cookie ≡ ⊤` and `decCookie` is the
-- constantly-`yes refl` decision.  So `c ≟ c′` reduces to `yes refl` for
-- ALL c c′ (`gateYes`), the errCookie branch is STATICALLY DEAD, and the
-- spec positions `kcErr`/`kcTermE` are UNREACHABLE.  The KA client bisim
-- therefore maps EVERY response to the loop; it needs NO err-branch states
-- and NO reflection of a live gate.  The two lemmas below are all the
-- client-response case needs (both discharged by `gateYes`).
--
-- (For a GENERIC live cookie the reflection would `with c ≟ c′ in eqc` and
-- `rewrite eqc` into the two branches — sound on the spec table; at THIS
-- instance that machinery is unnecessary because the gate is constant.)
------------------------------------------------------------------------

-- the KA client step function at the concrete (linkBD , hi) instance
cSrvC : (l : Link) → KAState → PTree KAEv (ExtI KAEv) (KAState ⊎ Rr)
cSrvC l = clientStep l hi

-- the KA client spec table at (linkBD , hi)
Tkc : (l : Link) → Table KAcPos
Tkc l = record { isFin = kaCfin ; nxt = kaCnxt l hi }

-- impl HOME / MID states for the KA client
kacI : (l : Link) → KAState → NetTree
kacI l q = RenKA.renameMap (SrcOp.iter (cSrvC l) q)
kacIB : (l : Link) → PTree KAEv (ExtI KAEv) (KAState ⊎ Rr) → NetTree
kacIB l t = RenKA.renameMap (SrcOp.iter-bind t (cSrvC l))

-- the cookie gate is CONSTANT at this instance (Cookie ≡ ⊤ ⇒ decEq⊤)
gateYes : (c c′ : Cookie) → (c ≟ c′) ≡ yes refl
gateYes c c′ = refl

-- GATE-REFLECTION (degenerate): every response cookie c′ makes the client
-- loop — impl → the loop re-entry sil; spec → kcClient.  No err target.
kcLoopImpl : (l : Link) → (c c′ : Cookie) (t : Time) (m : Mode) (len : Length)
           → visOf (kacI l (stServer c)) (Payload , output l hi N2N_KeepAlive)
                   (t , m , len , keepAlive (MsgKeepAliveResponse c′))
               ≡ just (kacIB l (SrcOp.Ret (inj₁ stClient)))
kcLoopImpl F.zero c c′ t m len = refl
kcLoopImpl (F.suc F.zero) c c′ t m len = refl
kcLoopImpl (F.suc (F.suc F.zero)) c c′ t m len = refl
kcLoopImpl (F.suc (F.suc (F.suc F.zero))) c c′ t m len = refl

kcLoopSpec : (l : Link) → (c c′ : Cookie) (t : Time) (m : Mode) (len : Length)
           → tMenu (Tkc l) (kcAwait c) (Payload , output l hi N2N_KeepAlive)
                   (t , m , len , keepAlive (MsgKeepAliveResponse c′))
               ≡ just (tableSpec (Tkc l) kcClient)
kcLoopSpec F.zero c c′ t m len = refl
kcLoopSpec (F.suc F.zero) c c′ t m len = refl
kcLoopSpec (F.suc (F.suc F.zero)) c c′ t m len = refl
kcLoopSpec (F.suc (F.suc (F.suc F.zero))) c c′ t m len = refl

------------------------------------------------------------------------
-- Item 3, THIRD PEER BISIM (FIRST CLIENT): `KAclientA linkBD hi ≈DR
-- kaClientSpec linkBD hi`.  Validates the CLIENT template.  Cookie ≡ ⊤
-- makes the response gate degenerate (gateYes) ⇒ the errCookie branch is
-- dead ⇒ NO kcErr/kcTermE states; the client is the keepalive loop
-- (cClient → iWmsg → cAwait → loop) with a sendKADone exit to √.
-- Reuses cSrvC/Tkc/kacI/kacIB + the gate-reflection lemmas already proved.
------------------------------------------------------------------------

-- the two fixed wire-send payloads the client emits (FromInitiator)
valMsg : Cookie → Payload
valMsg c = (time₀ , FromInitiator , length₀ , keepAlive (MsgKeepAlive c))
valKAdone : Payload
valKAdone = (time₀ , FromInitiator , length₀ , keepAlive MsgKADone)

-- the KA-client bisimulation relation: reachable impl states ↔ spec positions
data KACRel (l : Link) : NetTree → NetTree → Set₁ where
  cClient : KACRel l (kacI l stClient) (tableSpec (Tkc l) kcClient)
  cAwait : (c : Cookie) → KACRel l (kacI l (stServer c)) (tableSpec (Tkc l) (kcAwait c))
  cTerm : KACRel l (kacI l stDone) (tableSpec (Tkc l) kcTerm)
  mClient : KACRel l (kacIB l (SrcOp.Ret (inj₁ stClient))) (tableSpec (Tkc l) kcClient)
  mServer : (c : Cookie) → KACRel l (kacIB l (SrcOp.Ret (inj₁ (stServer c)))) (tableSpec (Tkc l) (kcAwait c))
  mDone : KACRel l (kacIB l (SrcOp.Ret (inj₁ stDone))) (tableSpec (Tkc l) kcTerm)
  iWmsg : (c : Cookie) → KACRel l (kacIB l (SrcOp.Output (sendKA l hi) (valMsg c) (SrcOp.Ret (inj₁ (stServer c))))) (tableSpec (Tkc l) (kcWmsg c))
  iWdone : KACRel l (kacIB l (SrcOp.Output (sendKA l hi) valKAdone (SrcOp.Prefix₀ (doneKA l hi) (SrcOp.Ret (inj₁ stDone))))) (tableSpec (Tkc l) kcWdone)
  iDdone : KACRel l (kacIB l (SrcOp.Prefix₀ (doneKA l hi) (SrcOp.Ret (inj₁ stDone)))) (tableSpec (Tkc l) kcDdone)
  cDead : KACRel l (deadlock {E = Net_Api Payload} {I = ExtI (Net_Api Payload)} {R = ⊤ {0ℓ}}) deadlock

-- a renamed iter-bind over a STABLE source node (react, empty τ-part) has no τ
noτ-ibKC : (l : Link) (Q : PTree KAEv (ExtI KAEv) (KAState ⊎ Rr))
           {vq : (at : AnyTypes KAEv) → ContinueType at (Maybe (PTree KAEv (ExtI KAEv) (KAState ⊎ Rr)))}
         → PTree.force Q ≡ react vq SrcOp.∅t
         → ∀ {X} → kacIB l Q ─[ τ ]─► X → ⊥
