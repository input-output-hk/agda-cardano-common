-- forward τ simulation: the only impl τs are the loop re-entry sils
kacFwdT : (l : Link) → ∀ {p q p′} → KACRel l p q → p ─[ τ ]─► p′
        → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × KACRel l p′ q′)
kacFwdT l cClient st = ⊥-elim (noτ-ibKC l (cSrvC l stClient) refl st)
kacFwdT l (cAwait c) st = ⊥-elim (noτ-ibKC l (cSrvC l (stServer c)) refl st)
kacFwdT l cTerm st = ⊥-elim (noτ-retKC l st)
kacFwdT l mClient (sSil refl) = _ , wτ τ*-refl , cClient
kacFwdT l mClient (sTau () _)
kacFwdT l (mServer c) (sSil refl) = _ , wτ τ*-refl , cAwait c
kacFwdT l (mServer c) (sTau () _)
kacFwdT l mDone (sSil refl) = _ , wτ τ*-refl , cTerm
kacFwdT l mDone (sTau () _)
kacFwdT l (iWmsg c) st = ⊥-elim (noτ-ibKC l (SrcOp.Output (sendKA l hi) (valMsg c) (SrcOp.Ret (inj₁ (stServer c)))) refl st)
kacFwdT l iWdone st = ⊥-elim (noτ-ibKC l (SrcOp.Output (sendKA l hi) valKAdone (SrcOp.Prefix₀ (doneKA l hi) (SrcOp.Ret (inj₁ stDone)))) refl st)
kacFwdT l iDdone st = ⊥-elim (noτ-ibKC l (SrcOp.Prefix₀ (doneKA l hi) (SrcOp.Ret (inj₁ stDone))) refl st)
kacFwdT l cDead (sSil ())
kacFwdT l cDead (sTau refl ())

