-- forward τ simulation: the only impl τs are the loop re-entry sils
bfsFwdT : (l : Link) → ∀ {p q p′} → BFSRel l p q → p ─[ τ ]─► p′
        → Σ[ q′ ∈ NetTree ] ((q ═[ τ ]═► q′) × BFSRel l p′ q′)
bfsFwdT l sIdle st = ⊥-elim (noτ-ibBF l (bSrv l BF.stIdle) refl st)
bfsFwdT l sBusy st = ⊥-elim (noτ-ibBF l (bSrv l BF.stBusy) refl st)
bfsFwdT l sStrm st = ⊥-elim (noτ-ibBF l (bSrv l BF.stStreaming) refl st)
bfsFwdT l sDone st = ⊥-elim (noτ-retBF l st)
bfsFwdT l mIdle (sSil refl) = _ , wτ τ*-refl , sIdle
bfsFwdT l mIdle (sTau () _)
bfsFwdT l mBusy (sSil refl) = _ , wτ τ*-refl , sBusy
bfsFwdT l mBusy (sTau () _)
bfsFwdT l mStrm (sSil refl) = _ , wτ τ*-refl , sStrm
bfsFwdT l mStrm (sTau () _)
bfsFwdT l mDone (sSil refl) = _ , wτ τ*-refl , sDone
bfsFwdT l mDone (sTau () _)
bfsFwdT l (iAreq r) st = ⊥-elim (noτ-ibBF l (SrcOpB.Output (BF.apiBFev l lo reqBFRange) r (SrcOpB.Ret (inj₁ BF.stBusy))) refl st)
bfsFwdT l iDdone st = ⊥-elim (noτ-ibBF l (SrcOpB.Prefix₀ (BF.doneBF l lo) (SrcOpB.Ret (inj₁ BF.stDone))) refl st)
bfsFwdT l iWsb st = ⊥-elim (noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valSB (SrcOpB.Ret (inj₁ BF.stStreaming))) refl st)
bfsFwdT l iWnb st = ⊥-elim (noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valNB (SrcOpB.Ret (inj₁ BF.stIdle))) refl st)
bfsFwdT l (iWblk b) st = ⊥-elim (noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) (valBLK b) (SrcOpB.Ret (inj₁ BF.stStreaming))) refl st)
bfsFwdT l iWbd st = ⊥-elim (noτ-ibBF l (SrcOpB.Output (BF.sendBF l lo) valBD (SrcOpB.Ret (inj₁ BF.stIdle))) refl st)
bfsFwdT l sDead (sSil ())
bfsFwdT l sDead (sTau refl ())

