  with S.stage f | drop (S.cursor f) (Types.infraPlan (S.layout f))
... | S.cfgReady | [] = case just-injective eq of λ { refl → stutter (λ role j found → found) }
... | S.cfgReady | _ ∷ _ = case eq of λ ()
