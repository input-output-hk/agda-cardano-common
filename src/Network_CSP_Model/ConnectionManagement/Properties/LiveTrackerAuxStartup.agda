Roles : S.PC → S.PC → Set
Roles before after = ∀ role j → S.roleId role before ≡ just j → S.roleId role after ≡ just j
empty : ∀ after → ∀ role j → lookup role [] ≡ just j → S.roleId role after ≡ just j
empty after role j ()
append-keeps : ∀ {K V : Set} ⦃ _ : DecEq K ⦄ (k : K) (xs ys : Store K V) v → lookup k xs ≡ just v → lookup k (xs ++ ys) ≡ just v
append-keeps k [] ys v ()
append-keeps k ((q , first) ∷ xs) ys v found with k ≟ q
... | yes _ = found
... | no _ = append-keeps k xs ys v found
put-fresh-keeps : ∀ (role : Types.Role) (j : JobId) (rows : Store Types.Role JobId) → lookup role rows ≡ nothing →
 ∀ q value → lookup q rows ≡ just value → lookup q (put role j rows) ≡ just value
put-fresh-keeps role j rows absent q value found with q ≟ role
... | yes refl = case trans (sym absent) found of λ ()
... | no apart = trans (lookup-put-other role q j rows apart) found
New : S.Action → (Result → Set) → Set
New (S.child a) C = K.NewReturn (S.poolAction a) C
New _ C = ⊤
record Evidence (a : S.Action) (s t : S.State) : Set₁ where
 constructor evidence
 field roles : Roles (S.phase s) (S.phase t)
       content : ∀ C → New a C → K.Content C (S.pool s) → K.Content C (S.pool t)
stutter : ∀ {a before after p} → Roles before after → Evidence a (S.startupState before p) (S.startupState after p)
stutter roles = evidence roles (λ C new good → good)
via-evidence : ∀ a pc action s {s′} → Roles (S.phase s) pc →
 (∀ C → New a C → K.NewReturn action C) → S.via pc action s ≡ just s′ → Evidence a s s′
via-evidence a pc action s roles supply eq with Pool.step action (S.pool s) in actual
... | nothing = case eq of λ ()
... | just p = case just-injective eq of λ { refl → evidence roles (λ C new good → K.step-preserves C action (S.pool s) actual good (supply C new)) }
step-evidence : ∀ action s {s′} → S.step action s ≡ just s′ → Evidence action s s′
