enact-prefix-ig : ∀ w worker result outcome s {t} → S.enactPrefixClose w worker result outcome s ≡ just t →
  S.ig t ≡ S.ig s
enact-prefix-ig w worker result nothing s eq with N.step
  (S.runMachine (Machine.admissionStep w Admission.close)) (S.base s)
... | nothing = case eq of λ ()
... | just n = case just-injective eq of λ { refl → refl }
enact-prefix-ig w worker result (just err) s eq = case just-injective eq of λ
  { refl → refl }
close-prefix-ig : ∀ w worker failure result outcome s {t} →
  S.closePrefixWorker w worker failure result outcome s ≡ just t → S.ig t ≡ S.ig s
close-prefix-ig w worker failure result outcome s eq with S.prefixMatches w failure s
... | false = case eq of λ ()
... | true = enact-prefix-ig w worker result outcome s eq
close-ig : ∀ w outcome s {t} → S.closeWorker w outcome s ≡ just t → S.ig t ≡ S.ig s
close-ig w outcome s eq with lookup w (S.workers s)
... | nothing = case eq of λ ()
... | just worker with S.pc worker
...   | S.closeDisconnected = case just-injective eq of λ
  { refl → refl }
...   | S.closeException err = case just-injective eq of λ
  { refl → refl }
...   | S.closePrefix f r = close-prefix-ig w worker f r outcome s eq
...   | S.calling = case eq of λ ()
...   | S.bodyExited _ = case eq of λ ()
...   | S.resultAvailable _ = case eq of λ ()


-- Every Server step keeps the stage, or is a scope action.
-- Pre-birth close preserves this observation.
fork-close-ig : ∀ outcome s {t} → S.closeFailedFork outcome s ≡ just t → S.ig t ≡ S.ig s
fork-close-ig outcome s eq with S.failedForkSocket s
... | nothing = case eq of λ ()
... | just sock with S.isAcceptedSocket sock s
...   | false = case eq of λ ()
...   | true = case just-injective eq of λ { refl → refl }

step-ig : ∀ a s {t} → S.step a s ≡ just t → S.ig t ≡ S.ig s ⊎ Σ S.ScopeAction (λ x → a ≡ S.scope x)
step-ig (S.closeForkFailure outcome) s eq = inj₁ (fork-close-ig outcome s eq)
step-ig (S.acceptedFork w req) s eq = inj₁ (fork-ig w req s eq)
step-ig (S.workerRestore w) s eq = inj₁ (body-restore-ig w s eq)
step-ig (S.run a) s eq = inj₁ (inherit-ig a s eq)
step-ig (S.workerReturned w) s eq = inj₁ (return-ig w s eq)
step-ig (S.workerPrefixReturned w) s eq = inj₁ (prefix-return-ig w s eq)
step-ig (S.workerPrefixException w err) s eq = inj₁ (prefix-exception-ig w err s eq)
step-ig (S.workerException w err) s eq = inj₁ (exception-ig w err s eq)
step-ig (S.workerClose w outcome) s eq = inj₁ (close-ig w outcome s eq)
step-ig (S.workerResult w) s eq = inj₁ (result-ig w s eq)
step-ig (S.scope x) s eq = inj₂ (x , refl)

-- A scope plan sets the stage it names.
enact-scope-ig : ∀ p s {t} → S.enactScope p s ≡ just t → S.ig t ≡ S.nextIG p
