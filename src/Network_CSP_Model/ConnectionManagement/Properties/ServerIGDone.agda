{-# OPTIONS --guardedness #-}

-- The IG thread's finished phases at the Server layer. Only Server scope
-- actions change the IG phase. A scope step reaches a finished IG phase only
-- from a finished one or by finishIGBody, keeps a finished phase finished, and
-- enters the post-IG stages (igJoined and later) only from them or by joinIG
-- with a finished IG.
open import ConnectionManagement.Domain using (ErrorId)
open import Data.Bool using (Bool)
module ConnectionManagement.Properties.ServerIGDone (isBearerClosed : ErrorId → Bool) where

open import Data.Bool using (true; false)
