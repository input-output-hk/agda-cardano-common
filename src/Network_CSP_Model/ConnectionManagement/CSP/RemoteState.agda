{-# OPTIONS --guardedness #-}

-- Promotion composes from real mux startup; remaining fixtures state their scope.
module ConnectionManagement.CSP.RemoteState where

open import Data.Integer using (+_)
open import Data.List using (List; []; _∷_; _++_; map)
open import Data.Maybe using (Maybe; just; nothing)
open import Relation.Binary.PropositionalEquality using (_≡_; refl)
open import Process_Trees
open import ConnectionManagement.Domain
open import ConnectionManagement.State
open import ConnectionManagement.Store using (lookup)
open import ConnectionManagement.Machine
open import ConnectionManagement.CSP.Process
open import ConnectionManagement.CSP.Correspondence
open import ConnectionManagement.CSP.Hiding
open import ConnectionManagement.CSP.Scope
open import ConnectionManagement.CSP.InboundRelease using (after; lock; replaceEntry)
open import ConnectionManagement.CSP.IGRegistration using (lifecycle; lifecycle-path; registeredState)
open import ConnectionManagement.CSP.IGRuntime using (jobRunning; startActions; start-path)
open import ConnectionManagement.CSP.Fixtures using (start)
open import ConnectionManagement.Scenarios.Admission using (key₀; child₀)
import ConnectionManagement.Rules.IGRegistration as IG
import ConnectionManagement.Rules.RemoteState as R
open import Semantics.Failures {E = Channel} {I = ExtI Channel} using (traces)

b₀ b₁ b₂ b₃ b₄ entered : Configuration
b₀ = after (igStep IG.finishBatch) jobRunning
b₁ = after (igStep (IG.captureTime 11)) b₀
b₂ = after (igStep IG.registerInactivity) b₁
b₃ = after (igStep IG.selectBatch) b₂
b₄ = after (igStep IG.readEvent) b₃
entered = after (remoteStep R.enter) b₄
batchActions : List Action
batchActions = igStep IG.finishBatch ∷ igStep (IG.captureTime 11) ∷
  igStep IG.registerInactivity ∷ igStep IG.selectBatch ∷ igStep IG.readEvent ∷ remoteStep R.enter ∷ []
batch-path : Executes jobRunning batchActions entered
batch-path = next {c₁ = b₀} refl (next {c₁ = b₁} refl (next {c₁ = b₂} refl
  (next {c₁ = b₃} refl (next {c₁ = b₄} refl (next refl done)))))

written checked counted returned warmPublished hotRead hotPublished : Configuration
written = after (remoteStep R.transact) entered
checked = after (remoteStep R.checkAssertion) written
counted = after (remoteStep R.readCounters) checked
returned = after (remoteStep R.returnToIG) counted
warmPublished = after (igStep IG.commitDecision) returned
hotRead = after (igStep IG.readEvent) warmPublished
hotPublished = after (igStep IG.commitDecision) hotRead
promotionActions : List Action
promotionActions = remoteStep R.transact ∷ remoteStep R.checkAssertion ∷ remoteStep R.readCounters ∷
  remoteStep R.returnToIG ∷ igStep IG.commitDecision ∷ igStep IG.readEvent ∷ igStep IG.commitDecision ∷ []
promotion-path : Executes entered promotionActions hotPublished
promotion-path = next {c₁ = written} refl (next {c₁ = checked} refl (next {c₁ = counted} refl
  (next {c₁ = returned} refl (next {c₁ = warmPublished} refl (next {c₁ = hotRead} refl (next refl done))))))
promotion-trace : traces (Process start)
  (map label (lifecycle ++ (startActions ++ (batchActions ++ promotionActions))))
promotion-trace = trace-intro (exec-append lifecycle-path
  (exec-append start-path (exec-append batch-path promotion-path)))
promotion-hidden : traces (HiddenProcess entered) (map label (project promotionActions))
promotion-hidden = hidden-trace promotion-path
cm-write-before-ig : lookup (ident 0) (entries (cm (world written))) ≡
  just (inboundActive key₀ child₀ (ident 0) duplex)
cm-write-before-ig = refl
ig-retains-old-state : IG.publishedState (inboundGovernor returned) ≡ registeredState
ig-retains-old-state = refl
hot-event-follows-warmPublished : IG.publishedState (inboundGovernor hotPublished) ≡
  IG.setRemote key₀ IG.remoteHot registeredState
hot-event-follows-warmPublished = refl
locked-transaction : advance (remoteStep R.transact) (lock entered) ≡ nothing
locked-transaction = refl
locked-later-counter : advance (remoteStep R.readCounters) (lock checked) ≡ nothing
locked-later-counter = refl
counter-before-assertion-refused : advance (remoteStep R.readCounters) written ≡ nothing
counter-before-assertion-refused = refl

-- Local demotion-event fixture after the composed promotion. No claim that this
-- injected event has been generated by a complete responder termination trace.
d₀ d₁ d₂ d₃ d₄ d₅ d₆ d₇ d₈ : Configuration
d₀ = record hotPublished { inboundGovernor = IG.setPC
  (IG.needsCM 11 [] (waitIdleRemote key₀) (IG.publishedState (inboundGovernor hotPublished)))
  (inboundGovernor hotPublished) }
d₁ = after (remoteStep R.enter) d₀
d₂ = after (remoteStep R.transact) d₁
d₃ = after (remoteStep R.checkAssertion) d₂
d₄ = after (remoteStep R.readCounters) d₃
d₅ = after (remoteStep R.returnToIG) d₄
d₆ = after (igStep IG.registerIdleTimer) d₅
d₇ = after (igStep IG.commitDecision) d₆
d₈ = after (igStep IG.finishBatch) d₇
demotionActions : List Action
demotionActions = remoteStep R.enter ∷ remoteStep R.transact ∷ remoteStep R.checkAssertion ∷
  remoteStep R.readCounters ∷ remoteStep R.returnToIG ∷ igStep IG.registerIdleTimer ∷
  igStep IG.commitDecision ∷ igStep IG.finishBatch ∷ []
demotion-path : Executes d₀ demotionActions d₈
demotion-path = next {c₁ = d₁} refl (next {c₁ = d₂} refl (next {c₁ = d₃} refl
  (next {c₁ = d₄} refl (next {c₁ = d₅} refl (next {c₁ = d₆} refl (next {c₁ = d₇} refl (next refl done)))))))
demotion-trace : traces (Process d₀) (map label demotionActions)
demotion-trace = trace-intro demotion-path
demotion-writes-idle : lookup (ident 0) (entries (cm (world d₂))) ≡
  just (inboundIdle key₀ child₀ (ident 0) duplex)
demotion-writes-idle = refl
no-publication-before-timer : advance (igStep IG.commitDecision) d₅ ≡ nothing
no-publication-before-timer = refl
new-timer-publication : IG.publishedState (inboundGovernor d₇) ≡
  IG.setRemote key₀ (IG.remoteIdle (ident 3)) (IG.publishedState (inboundGovernor hotPublished))
new-timer-publication = refl

-- Unsupported promotion still prepares RemoteWarm and skips the counter read.
u₀ u₁ u₂ u₃ : Configuration
u₀ = replaceEntry (outboundIdle key₀ child₀ (ident 0) unidirectional) entered
u₁ = after (remoteStep R.transact) u₀
u₂ = after (remoteStep R.checkAssertion) u₁
u₃ = after (remoteStep R.returnToIG) (lock u₂)
unsupported-promotion-path : Executes u₀ (remoteStep R.transact ∷ remoteStep R.checkAssertion ∷ []) u₂
unsupported-promotion-path = next {c₁ = u₁} refl (next refl done)
unsupported-can-return-with-map-taken : advance (remoteStep R.returnToIG) (lock u₂) ≡ just u₃
unsupported-can-return-with-map-taken = refl
unsupported-prepares-warmPublished : IG.continuation (inboundGovernor u₃) ≡
  IG.publishDecision 11 (remotePromotedToHot key₀ ∷ []) (IG.setRemote key₀ IG.remoteWarm registeredState)
unsupported-prepares-warmPublished = refl

-- TerminatedConnection is distinct from unsupported and still reads counters.
t₀ t₁ t₂ t₃ t₄ : Configuration
t₀ = replaceEntry (terminated nothing) d₁
t₁ = after (remoteStep R.transact) t₀
t₂ = after (remoteStep R.checkAssertion) t₁
t₃ = after (remoteStep R.readCounters) t₂
t₄ = after (remoteStep R.returnToIG) t₃
terminated-path : Executes t₀ (remoteStep R.transact ∷ remoteStep R.checkAssertion ∷
  remoteStep R.readCounters ∷ remoteStep R.returnToIG ∷ []) t₄
terminated-path = next {c₁ = t₁} refl (next {c₁ = t₂} refl (next {c₁ = t₃} refl (next refl done)))
terminated-still-blocks-on-counter : advance (remoteStep R.readCounters) (lock t₂) ≡ nothing
terminated-still-blocks-on-counter = refl
terminated-skips-timer : IG.continuation (inboundGovernor t₄) ≡ IG.readNext 11 []
terminated-skips-timer = refl

-- Enabled assertion failures cannot silently count or return.
a₀ a₁ a₂ : Configuration
a₀ = replaceEntry reservedOutbound entered
a₁ = after (remoteStep R.transact) a₀
a₂ = after (remoteStep R.checkAssertion) a₁
assertion-path : Executes a₀ (remoteStep R.transact ∷ remoteStep R.checkAssertion ∷ []) a₂
assertion-path = next {c₁ = a₁} refl (next refl done)
assertion-frontier : remoteFrontier (remoteCall a₂) ≡ just igRemoteAssertion
assertion-frontier = refl
assertion-cannot-return : advance (remoteStep R.returnToIG) a₂ ≡ nothing
assertion-cannot-return = refl

-- Capacity is tested before promotion writes; over-limit cases require scores.
p₀ p₁ : Configuration
p₀ = record (replaceEntry (outboundDup key₀ child₀ (ident 0) expired) entered) { promotionHardLimit = 0 }
p₁ = after (remoteStep (R.transactPruning 0 (+ 0 ∷ []))) p₀
pruning-path : Executes p₀ (remoteStep (R.transactPruning 0 (+ 0 ∷ [])) ∷ []) p₁
pruning-path = next refl done
pruning-is-implemented : remoteFrontier (remoteCall p₁) ≡ nothing
pruning-is-implemented = refl
pruning-self-terminates : lookup (ident 0) (entries (cm (world p₁))) ≡ just (terminated nothing)
pruning-self-terminates = refl
pruning-cannot-return : advance (remoteStep R.returnToIG) p₁ ≡ nothing
pruning-cannot-return = refl

capacityAvailable capacityWritten : Configuration
capacityAvailable = record p₀ { promotionHardLimit = 1 }
capacityWritten = after (remoteStep R.transact) capacityAvailable
exact-capacity-path : Executes capacityAvailable (remoteStep R.transact ∷ []) capacityWritten
exact-capacity-path = next refl done
exact-capacity-promotes : lookup (ident 0) (entries (cm (world capacityWritten))) ≡
  just (duplexActive key₀ child₀ (ident 0))
exact-capacity-promotes = refl

-- Check the result distinction, not merely the shared IG skip behavior.
callOutcome : Configuration → Maybe R.Outcome
callOutcome c with remoteCall c
... | nothing = nothing
... | just f = just (R.outcome f)
terminated-classification : callOutcome t₁ ≡ just (R.terminatedConnection (terminated nothing))
terminated-classification = refl

-- A missing binding is unsupported; demotion must still perform its counter read.
m₀ m₁ m₂ : Configuration
m₀ = record d₁ { world = record (world d₁) { cm = record (cm (world d₁)) { mapCell = full [] } } }
m₁ = after (remoteStep R.transact) m₀
m₂ = after (remoteStep R.checkAssertion) m₁
missing-demotion-path : Executes m₀ (remoteStep R.transact ∷ remoteStep R.checkAssertion ∷ []) m₂
missing-demotion-path = next {c₁ = m₁} refl (next refl done)
missing-is-unsupported : callOutcome m₁ ≡ just (R.unsupported nothing)
missing-is-unsupported = refl
missing-cannot-return-before-counter : advance (remoteStep R.returnToIG) m₂ ≡ nothing
missing-cannot-return-before-counter = refl

badDemotion badDemotionWritten badDemotionFailed : Configuration
badDemotion = replaceEntry reservedOutbound d₁
badDemotionWritten = after (remoteStep R.transact) badDemotion
badDemotionFailed = after (remoteStep R.checkAssertion) badDemotionWritten
bad-demotion-path : Executes badDemotion
  (remoteStep R.transact ∷ remoteStep R.checkAssertion ∷ []) badDemotionFailed
bad-demotion-path = next {c₁ = badDemotionWritten} refl (next refl done)
demotion-assertion-frontier : remoteFrontier (remoteCall badDemotionFailed) ≡ just igRemoteAssertion
demotion-assertion-frontier = refl
demotion-assertion-prevents-counter : advance (remoteStep R.readCounters) badDemotionFailed ≡ nothing
demotion-assertion-prevents-counter = refl
